ument(\"--strategy\", choices=[\"gated\", \"const_ph\", \"always_reg\"], default=\"gated\")\\n    ap.add_argument(\"--tune-tau\", action=\"store_true\")\\n    ap.add_argument(\"--full\", action=\"store_true\", help=\"train 后再做全量训练\")\\n    ap.add_argument(\"--device\", default=\"auto\")\\n    ap.add_argument(\"--cnn\", action=\"store_true\", help=\"同时训练 CNN（需 torch/GPU）\")\\n    ap.add_argument(\"--cnn-dir\", default=\"artifacts/cnn\")\\n    ap.add_argument(\"--cnn-weight\", type=float, default=0.5)\\n    ap.add_argument(\"--cnn-epochs\", type=int, default=20)\\n    ap.add_argument(\"--cnn-batch\", type=int, default=16)\\n    ap.add_argument(\"--blend-grid\", type=float, nargs=\"+\", default=[0.0, 0.25, 0.5, 0.75, 1.0])\\n    ap.add_argument(\"--clean\", action=\"store_true\", help=\"训练前清空 model_dir/cnn_dir 全部旧产物\")\\n    ap.add_argument(\"--retrain\", action=\"store_true\", help=\"强制重训（默认复用已有模型/OOF）\")\\n    return ap\\n\\n\\ndef main(argv=None):\\n    ap = build_parser()\\n    args = ap.parse_args(argv)\\n    if args.strategy != \"gated\":\\n        print(f\"[warn] strategy={args.strategy} 暂仅实现 gated，按 gated 执行\")\\n    if args.clean:\\n        _clean_stale(Path(args.model_dir), [\"oof_*.npy\", \"taus.json\", \"fold*\", \"full\"])\\n        _clean_stale(Path(args.cnn_dir), [\"oof_*.npy\", \"folds.json\", \"fold*\"])\\n        for f in (Path(args.out), Path(\"result.json\")):\\n            try:\\n                if f.is_file():\\n                    f.unlink()\\n                    print(f\"[clean] removed {f}\")\\n            except Exception:\\n                pass\\n    if args.mode in (\"train\", \"both\"):\\n        cmd_train(args)\\n    if args.mode in (\"infer\", \"both\"):\\n        cmd_infer(args)\\n\\n\\nif __name__ == \"__main__\":\\n    main()\\n',\n","}\n","_HASHES = {\n","  'src/config.py': 'dd11f59c33e1',\n","  'src/labels.py': '5166dade13fa',\n","  'src/io_data.py': '26f498beb472',\n","  'src/scoring.py': 'c2b489366b72',\n","  'src/features.py': 'ea