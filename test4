rap门槛,未过则纯LGBM\")\n","from pathlib import Path as _Path\n","try:\n","    _ROOT = _Path(__file__).resolve().parent\n","except Exception:\n","    _ROOT = _Path('.').resolve()\n","_FILES = {\n","  'src/config.py': # sha:dd11f59c33e1\n","    '\"\"\"全局配置与常量。\"\"\"\\nfrom __future__ import annotations\\n\\nSEED = 42\\n\\n# 输入曲线（按 rules.md 顺序，DEPTH 为定位基准不作特征）\\nINPUT_COLS = [\"GR\", \"PE\", \"SP\", \"CAL\", \"AC\", \"DEN\", \"CNL\",\\n              \"RXO\", \"RT\", \"DEVI\", \"AZIM\", \"BIT\", \"CASE\"]\\nTARGET_COLS = [\"POR\", \"PERM\", \"SW\"]\\n\\n# 占位三元组（联合常量状态）\\nPH_POR, PH_PERM, PH_SW = 0.1, 0.01, 99.9\\nMISS_VAL = -99999.0\\n\\n# 合法区间（注意：POR 下界取 >=0 才能复现 PLAN §2.2 的\\n# VALID=236331 / GARBAGE=140；若用 >0 则 VALID=236165 / GARBAGE=306。\\n# PLAN 正文写 (0,60] 与其数字自相矛盾，此处以数字为准。）\\nPOR_MIN, POR_MAX = 0.0, 60.0\\nPERM_MIN, PERM_MAX = 1e-6, 5000.0\\nSW_MIN, SW_MAX = 0.0, 100.0  # 下界 exclusive（>0），但无边界样本，>=/>等价\\n\\n# 评分\\nEPS = 1e-6\\nWEIGHTS = {\"POR\": 0.30, \"PERM\": 0.35, \"SW\": 0.35}\\n\\n# 决策层初值（PLAN §4.2 闭式解，由 OOF 的 A_t 算出；此处为 LightGBM 基线对应的初值）\\nTAU_INIT = {\"POR\": 0.258, \"PERM\": 0.434, \"SW\": 0.146}\\nTAU_TUNE_RADIUS = 0.05\\n\\n# SW 量纲开关：1.0=百分制（默认，与训练标签一致）；0.01=小数制\\nSW_SCALE = 1.0\\n\\n# 特征工程\\nROLL_WINDOWS = [5, 11, 31, 101, 301, 1001]\\nROLL_STD_WINDOWS = [31, 101]\\nSENTINEL = -99999.0\\n\\n# 切片（CNN 用；LightGBM 为逐点模型不需要切片）\\nSLICE_LEN = 4096\\nSLICE_OVERLAP = 1024\\nSLICE_STEP = SLICE_LEN - SLICE_OVERLAP\\n\\n# CNN 结构\\nCNN_WIDTH = 192\\nCNN_KERNEL = 5\\nCNN_DILATIONS = [1, 2, 4, 8, 16, 32, 64, 128, 256]\\nCNN_DROPOUT = 0.05\\n\\n# LightGBM 参数\\nLGBM_CLASSIFIER_PARAMS = dict(\\n    objective=\"binary\",\\n    metric=\"auc\",\\n    num_leaves=63,\\n    learning_rate=0.05,\\n    feature_fraction=0.8,\\n    bagging_fraction=0.8,\\n    bagging_freq=1,\\n    min_data_in_leaf=100,\\n    num_threads=6,\\n    verbosity=-1,\\n)\\nLGBM_REG_PARAMS = dict(\\n    objective=\"regression_l1\",\\n    learning_rate=0.05,\\n    num_leaves=63,\\n    feature_fraction=0.8,\\n    bagging_fraction=0.8,\\n    bagging_freq=1,\\n    min_data_in_leaf=100,\\n    num_threads=6,\\n    verbosity=-1,\\n)\\nLGBM_ROUNDS = 1000\\nLGBM_EARLY_STOP = 100\\n\\n# 路径探测（本地默认 ./data；Kaggle 见 io_data.detect_data_root）\\nLOCAL_DATA_DIR = \"data\"\\n',\n","  'src/labels.py': # sha:5166dade13fa\n","    '\"\"\"标签四态 + 逐目标 mask。\\n\\n定义（与 PLAN §2.2 的精确对账数字绑定）：\\n- PH 占位：POR==0.1 & PERM==0.01 & SW==99.9  -> 487225\\n- MISS 缺测：三目标全部 == -99999            -> 6572\\n- GARBAGE 损坏：非 PH 非 MISS，且存在按目标的区间外取值 -> 140\\n- VALID 有效：其余                            -> 236331\\n合计 730268。\\n\\n逐目标 mask_t（对齐 rules.md:83 的 missing_t 契约）：\\nmask_t 为 True 表示该目标在该行参与训练/评分。\\n- PH 行：三目标全 True（作为联合常量状态参与全量评分）\\n- MISS 行：三目标全 False\\n- 其余行：逐目标按区间判定（区间外则该目标 False）\\n\\n区间（以复现数字为准）：\\nPOR ∈ [0,60]、PERM ∈ (1e-6,5000]、SW ∈ (0,100]。\\n注意 PLAN 正文把 POR 写成 (0,60]，但那样 VALID=236165/GARBAGE=306，\\n与 PLAN 自己的 236331/140 矛盾。实测 POR==0 的 166 行三目标其余均合法，\\n必须计为 VALID 才能对账。此处采用 >=0。\\n\"\"\"\\nfrom __future__ import annotations\\n\\nimport numpy as np\\nimport pandas as pd\\n\\nfrom . import config as C\\n\\n\\ndef _valid_por(s: pd.Series) -> pd.Series:\\n    return (s >= C.POR_MIN) & (s <= C.POR_MAX)\\n\\n\\ndef _valid_perm(s: pd.Series) -> pd.Series:\\n    return (s > C.PERM_MIN) & (s <= C.PERM_MAX)\\n\\n\\ndef _valid_sw(s: pd.Series) -> pd.Series:\\n    return (s > C.SW_MIN) & (s <= C.SW_MAX)\\n\\n\\ndef make_labels(df: pd.DataFrame):\\n    \"\"\"输入含 POR/PERM/SW 列的 DataFrame，返回 (state, mask_df)。\\n\\n    state: pd.Series，取值为 PH/MISS/GARBAGE/VALID\\n    mask_df: DataFrame，列为 POR/PERM/SW 的 bool（True=参与训练/评分）\\n    \"\"\"\\n    por = df[\"POR\"].astype(float)\\n    perm = df[\"PERM\"].astype(float)\\n    sw = df[\"SW\"].astype(float)\\n\\n    is_ph = (por == C.PH_POR) & (perm == C.PH_PERM) & (sw == C.PH_SW)\\n    is_miss_all = (por == C.MISS_VAL) & (perm == C.MISS_VAL) & (sw == C.MISS_VAL)\\n\\n    vok = _valid_por(por)\\n    mok = _valid_perm(perm)\\n    sok = _valid_sw(sw)\\n\\n    rest = ~is_ph & ~is_miss_all\\n    is_garbage = rest & ~(vok & mok & sok)\\n    is_valid = rest & (vok & mok & sok)\\n\\n    state = pd.Series(\"VALID\", index=df.index, dtype=object)\\n    state[is_ph] = \"PH\"\\n    state[is_miss_all] = \"MISS\"\\n    state[is_garbage] = \"GARBAGE\"\\n    # is_valid 已默认为 VALID\\n    assert set(state.unique()) <= {\"PH\", \"MISS\", \"GARBAGE\", \"VALID\"}\\n\\n    mask = pd.DataFrame(\\n        {\"POR\": vok, \"PERM\": mok, \"SW\": sok},\\n        index=df.index,\\n    )\\n    # PH 行三目标全参与（区间内，本来就全 True；显式保证）\\n    mask.loc[is_ph, [\"POR\", \"PERM\", \"SW\"]] = True\\n    # MISS 行三目标全不参与\\n    mask.loc[is_miss_all, [\"POR\", \"PERM\", \"SW\"]] = False\\n    return state, mask\\n\\n\\ndef is_placeholder_row(por: float, perm: float, sw: float) -> bool:\\n    return por == C.PH_POR and perm == C.PH_PERM and sw == C.PH_SW\\n',\n","  'src/io_data.py': # sha:26f498beb472\n","    '\"\"\"数据读写：按表头名取列、跳单位行、探测路径、写 result.json。\"\"\"\\nfrom __future__ import annotations\\n\\nimport json\\nimport os\\nfrom pathlib import Path\\n\\nimport numpy as np\\nimport pandas as pd\\n\\nfrom . import config as C\\n\\nCANONICAL_INPUTS = C.INPUT_COLS\\nTARGETS = C.TARGET_COLS\\n\\n\\ndef detect_data_root(explicit: str | None = None) -> Path:\\n    \"\"\"按优先级探测数据根目录（含 train/ test 子目录或直接为 train/）。\"\"\"\\n    candidates: list[Path] = []\\n    if explicit:\\n        candidates.append(Path(explicit))\\n    candidates += [\\n        Path(\"/kaggle/input/datasets/fangqy/petroleum-competition-data/data\"),\\n        Path(\"/kaggle/input/petroleum-competition-data/data\"),\\n        Path(\"./data\"),\\n        Path(\"data\"),\\n        Path(\"/home/fangqiyu/projects/Petroleum-Competition/data\"),\\n    ]\\n    # artifacts 挂载的兼容：有人把 data 放在 dataset 根下\\n    for c in candidates:\\n        if (c / \"train\").is_dir() and (c / \"test\").is_dir():\\n            return c\\n        # 直接指向 train/ 的情况\\n        if c.name == \"train\" and c.is_dir():\\n            return c.parent\\n    # 最后兜底：环境变量\\n    env = os.environ.get(\"PETRO_DATA_DIR\")\\n    if env and Path(env).exists():\\n        return Path(env)\\n    return Path(\"./data\")\\n\\n\\ndef list_well_files(data_root: Path | str, split: str) -> list[Path]:\\n    d = Path(data_root) / split\\n    files = sorted(d.glob(\"*.txt\"))\\n    return files\\n\\n\\ndef read_well(path: Path | str) -> pd.DataFrame:\\n    \"\"\"读取单口井。按表头名映射列，缺失列填 NaN，多余列丢弃。\\n\\n    - 去 UTF-8 BOM（utf-8-sig）\\n    - 第 1 行为表头（strip），第 2 行为单位（跳过），第 3 行起数据\\n    - 返回列：DEPTH + INPUT_COLS(13) + TARGETS(若有)；全部 float\\n    - 不把 -99999 转 NaN（调用方按需转）；保留原始数值供 labels 判定\\n    \"\"\"\\n    path = Path(path)\\n    with open(path, \"r\", encoding=\"utf-8-sig\") as fh:\\n        header_line = fh.readline()\\n    header = [h.strip() for h in header_line.strip().split(\",\")]\\n    # 数据从第 3 行起：header=0 + skiprows=[1]\\n    df = pd.read_csv(path, encoding=\"utf-8-sig\", header=0, skiprows=[1])\\n    # pandas 可能保留 BOM 或空格，统一 strip\\n    df.columns = [str(c).strip() for c in df.columns]\\n    # 按表头名取列\\n    want = [\"DEPTH\"] + CANONICAL_INPUTS + TARGETS\\n    out = pd.DataFrame(index=df.index)\\n    for col in want:\\n        if col in df.columns:\\n            out[col] = pd.to_numeric(df[col], errors=\"coerce\")\\n        else:\\n            out[col] = np.nan\\n    # DEPTH 必须存在\\n    if out[\"DEPTH\"].isna().any():\\n        raise ValueError(f\"{path}: DEPTH 缺失或非数值\")\\n    return out\\n\\n\\ndef well_id_of(path: Path | str) -> str:\\n    return Path(path).stem\\n\\n\\ndef write_result_json(\\n    wells: list[dict],\\n    out_path: Path | str,\\n    model_name: str = \"petroleum-gated-lgbm\",\\n    version: str = \"1.0\",\\n    model_id: str = \"\",\\n) -> Path:\\n    \"\"\"wells: [{logId, depths(np), por(np), perm(np), sw(np)}]。depth 逐值等于输入。\"\"\"\\n    out_path = Path(out_path)\\n    result_data = []\\n    for w in wells:\\n        preds = [\\n            {\\n                \"depth\": float(d),\\n                \"POR\": float(por),\\n                \"PERM\": float(perm),\\n                \"SW\": float(sw),\\n            }\\n            for d, por, perm, sw in zip(\\n                w[\"depths\"], w[\"por\"], w[\"perm\"], w[\"sw\"]\\n            )\\n        ]\\n        result_data.append({\"logId\": w[\"logId\"], \"predictions\": preds})\\n    obj = {\\n        \"modelId\": model_id,\\n        \"modelName\": model_name,\\n        \"version\": version,\\n        \"resultData\": result_data,\\n    }\\n    out_path.parent.mkdir(parents=True, exist_ok=True)\\n    with open(out_path, \"w\", encoding=\"utf-8\") as fh:\\n        json.dump(obj, fh)\\n    validate_result_json(out_path)\\n    return out_path\\n\\n\\ndef validate_result_json(path: Path | str) -> None:\\n    with open(path, \"r\", encoding=\"utf-8\") as fh:\\n        obj = json.load(fh)\\n    assert set(obj.keys()) == {\"modelId\", \"modelName\", \"version\", \"resultData\"}, obj.keys()\\n    assert isinstance(obj[\"resultData\"], list) and len(obj[\"resultData\"]) > 0\\n    for w in obj[\"resultData\"]:\\n        assert set(w.keys()) == {\"logId\", \"predictions\"}, w.keys()\\n        assert isinstance(w[\"logId\"], str) and len(w[\"logId\"]) > 0\\n        preds = w[\"predictions\"]\\n        assert isinstance(preds, list) and len(preds) > 0\\n        for p in preds:\\n            assert set(p.keys()) == {\"depth\", \"POR\", \"PERM\", \"SW\"}, p.keys()\\n            for k in (\"depth\", \"POR\", \"PERM\", \"SW\"):\\n                assert isinstance(p[k], (int, float)), (k, p[k])\\n                assert np.isfinite(p[k]), (k, p[k])\\n        # 深度单调递增、步长 0.1\\n        depths = np.array([p[\"depth\"] for p in preds], dtype=float)\\n        assert np.all(np.diff(depths) > 0), \"DEPTH 必须严格单调\"\\n',\n","  'src/scoring.py': # sha:c2b489366b72\n","    '\"\"\"评分：官方三目标准确率 + 综合总分。ε 固定 1e-6。\"\"\"\\nfrom __future__ import annotations\\n\\nimport numpy as np\\n\\nfrom . import config as C\\n\\nEPS = C.EPS\\n\\n\\ndef acc_por(y_true, y_pred, eps: float = EPS) -> float:\\n    y_true = np.asarray(y_true, dtype=float)\\n    y_pred = np.asarray(y_pred, dtype=float)\\n    denom = 0.08 * (np.abs(y_true) + eps)\\n    s = 1.0 - np.abs(y_pred - y_true) / denom\\n    return float(np.mean(np.maximum(0.0, s)))\\n\\n\\ndef acc_perm(y_true, y_pred, eps: float = EPS) -> float:\\n    y_true = np.asarray(y_true, dtype=float)\\n    y_pred = np.asarray(y_pred, dtype=float)\\n    # 预测/真实都先钳到正数，避免 log 未定义；官方未明说负预测，按 0 截断\\n    ratio = np.maximum(np.asarray(y_pred, dtype=float) / np.maximum(y_true, eps), eps)\\n    # y_true<=0 的行调用方应已 mask；此处对非正真实值按最坏处理\\n    s = 1.0 - np.abs(np.log10(ratio))\\n    s = np.where(np.asarray(y_true) <= 0, 0.0, s)\\n    return float(np.mean(np.maximum(0.0, s)))\\n\\n\\ndef acc_sw(y_true, y_pred, eps: float = EPS) -> float:\\n    y_true = np.asarray(y_true, dtype=float)\\n    y_pred = np.asarray(y_pred, dtype=float)\\n    denom = 0.05 * (np.abs(y_true) + eps)\\n    s = 1.0 - np.abs(y_pred - y_true) / denom\\n    return float(np.mean(np.maximum(0.0, s)))\\n\\n\\ndef total_score(a_por: float, a_perm: float, a_sw: float) -> float:\\n    w = C.WEIGHTS\\n    return 100.0 * (w[\"POR\"] * a_por + w[\"PERM\"] * a_perm + w[\"SW\"] * a_sw)\\n\\n\\ndef score_all(y_true: dict, y_pred: dict, mask: dict | None = None) -> dict:\\n    \"\"\"y_true/y_pred: {POR,PERM,SW: array}；mask 可选逐目标 bool 数组。\"\"\"\\n    out = {}\\n    for t, fn in ((\"POR\", acc_por), (\"PERM\", acc_perm), (\"SW\", acc_sw)):\\n        yt = np.asarray(y_true[t], dtype=float)\\n        yp = np.asarray(y_pred[t], dtype=float)\\n        if mask is not None and t in mask and mask[t] is not None:\\n            m = np.asarray(mask[t], dtype=bool)\\n            yt, yp = yt[m], yp[m]\\n        out[t] = fn(yt, yp)\\n    out[\"total\"] = total_score(out[\"POR\"], out[\"PERM\"], out[\"SW\"])\\n    return out\\n\\n\\n# 独立双实现（对拍用，纯 Python 循环版）\\ndef acc_por_loop(y_true, y_pred, eps: float = EPS) -> float:\\n    s = 0.0\\n    n = len(y_true)\\n    for yt, yp in zip(y_true, y_pred):\\n        v = 1.0 - abs(yp - yt) / (0.08 * (abs(yt) + eps))\\n        s += max(0.0, v)\\n    return s / n if n else 0.0\\n\\n\\ndef acc_perm_loop(y_true, y_pred, eps: float = EPS) -> float:\\n    import math\\n\\n    s = 0.0\\n    n = len(y_true)\\n    for yt, yp in zip(y_true, y_pred):\\n        if yt <= 0:\\n            continue_all = 0.0\\n            s += 0.0\\n            continue\\n        r = max(yp / max(yt, eps), eps)\\n        v = 1.0 - abs(math.log10(r))\\n        s += max(0.0, v)\\n    return s / n if n else 0.0\\n\\n\\ndef acc_sw_loop(y_true, y_pred, eps: float = EPS) -> float:\\n    s = 0.0\\n    n = len(y_true)\\n    for yt, yp in zip(y_true, y_pred):\\n        v = 1.0 - abs(yp - yt) / (0.05 * (abs(yt) + eps))\\n        s += max(0.0, v)\\n    return s / n if n else 0.0\\n',\n","  'src/features.py': # sha:ea28df0505be\n","    '\"\"\"特征工程（152 通道，推理时仅依赖输入+DEPTH，无标签泄漏）。\\n\\n组成：\\n1. 原始 12 曲线 + CASE 缺失标记 + 逐列缺失指示\\n2. 多尺度滑动均值（5/11/31/101/301/1001）\\n3. 差分与滚动标准差\\n4. 物理解释特征（多套基质假设，避免单位假设错误）\\n5. 井内相对深度（删除绝对深度）+ 全井聚合统计\\n6. 逐列缺失率（井级，广播到各行）\\n\"\"\"\\nfrom __future__ import annotations\\n\\nimport numpy as np\\nimport pandas as pd\\n\\nfrom . import config as C\\n\\nRAW12 = [\"GR\", \"PE\", \"SP\", \"CAL\", \"AC\", \"DEN\", \"CNL\", \"RXO\", \"RT\", \"DEVI\", \"AZIM\", \"BIT\"]\\nALL_INPUTS = C.INPUT_COLS\\n\\n\\ndef _to_nan(df: pd.DataFrame) -> pd.DataFrame:\\n    out = df.copy()\\n    for c in ALL_INPUTS:\\n        if c in out.columns:\\n            v = pd.to_numeric(out[c], errors=\"coerce\").astype(float)\\n            v = v.where(v != C.SENTINEL, np.nan)\\n            # CASE 列常见 -99999，同样转 NaN\\n            out[c] = v\\n    return out\\n\\n\\ndef build_features(well_df: pd.DataFrame) -> pd.DataFrame:\\n    \"\"\"单井 DataFrame（含 DEPTH + INPUT_COLS）-> 特征 DataFrame（与输入等长）。\"\"\"\\n    df = _to_nan(well_df)\\n    n = len(df)\\n    feats: dict[str, np.ndarray] = {}\\n\\n    def add(name: str, arr):\\n        a = np.asarray(arr, dtype=float)\\n        assert a.shape == (n,), (name, a.shape, n)\\n        feats[name] = a\\n\\n    # ---- 1. 原始 + 缺失指示 ----\\n    for c in RAW12:\\n        v = df[c].to_numpy(dtype=float) if c in df.columns else np.full(n, np.nan)\\n        add(f\"raw_{c}\", v)\\n        add(f\"miss_{c}\", np.isnan(v).astype(float))\\n    # CASE：原始基本全缺，只保留缺失标记 + 逐列缺失率在井级特征中\\n    case_v = df[\"CASE\"].to_numpy(dtype=float) if \"CASE\" in df.columns else np.full(n, np.nan)\\n    add(\"miss_CASE\", np.isnan(case_v).astype(float))\\n\\n    # ---- 2. 多尺度滑动均值（对每条主要曲线）----\\n    roll_cols = [\"GR\", \"PE\", \"SP\", \"CAL\", \"AC\", \"DEN\", \"CNL\", \"RXO\", \"RT\"]\\n    for c in roll_cols:\\n        v = pd.Series(df[c].to_numpy(dtype=float) if c in df.columns else np.full(n, np.nan))\\n        for w in C.ROLL_WINDOWS:\\n            m = v.rolling(window=w, min_periods=1, center=True).mean().to_numpy()\\n            add(f\"roll{w}_{c}\", m)\\n\\n    # ---- 3. 差分与滚动标准差 ----\\n    for c in [\"GR\", \"AC\", \"DEN\", \"CNL\", \"RT\", \"RXO\", \"SP\"]:\\n        v = pd.Series(df[c].to_numpy(dtype=float) if c in df.columns else np.full(n, np.nan))\\n        d1 = v.diff().fillna(0).to_numpy()\\n        d2 = v.diff().diff().fillna(0).to_numpy()\\n        add(f\"d1_{c}\", d1)\\n        add(f\"d2_{c}\", d2)\\n        for w in C.ROLL_STD_WINDOWS:\\n            s = v.rolling(window=w, min_periods=5, center=True).std().fillna(0).to_numpy()\\n            add(f\"std{w}_{c}\", s)\\n\\n    # ---- 4. 物理解释特征（多套假设） ----\\n    den = df[\"DEN\"].to_numpy(dtype=float) if \"DEN\" in df.columns else np.full(n, np.nan)\\n    cnl = df[\"CNL\"].to_numpy(dtype=float) if \"CNL\" in df.columns else np.full(n, np.nan)\\n    ac = df[\"AC\"].to_numpy(dtype=float) if \"AC\" in df.columns else np.full(n, np.nan)\\n    gr = df[\"GR\"].to_numpy(dtype=float) if \"GR\" in df.columns else np.full(n, np.nan)\\n    rt = df[\"RT\"].to_numpy(dtype=float) if \"RT\" in df.columns else np.full(n, np.nan)\\n    rxo = df[\"RXO\"].to_numpy(dtype=float) if \"RXO\" in df.columns else np.full(n, np.nan)\\n    cal = df[\"CAL\"].to_numpy(dtype=float) if \"CAL\" in df.columns else np.full(n, np.nan)\\n    bit = df[\"BIT\"].to_numpy(dtype=float) if \"BIT\" in df.columns else np.full(n, np.nan)\\n    sp = df[\"SP\"].to_numpy(dtype=float) if \"SP\" in df.columns else np.full(n, np.nan)\\n    devi = df[\"DEVI\"].to_numpy(dtype=float) if \"DEVI\" in df.columns else np.full(n, np.nan)\\n    azim = df[\"AZIM\"].to_numpy(dtype=float) if \"AZIM\" in df.columns else np.full(n, np.nan)\\n\\n    # 密度孔隙度（基质 2.65 / 2.71，流体 1.0）\\n    for rho_ma in (2.65, 2.71):\\n        phi_d = (rho_ma - den) / (rho_ma - 1.0)\\n        add(f\"phiD_{rho_ma}\", phi_d)\\n    # 中子（%/p.u. 两套写法都试：直接 /100 与原值）\\n    cnl_frac = cnl / 100.0\\n    add(\"cnl_frac\", cnl_frac)\\n    # Δρ 气层指示：phiD(2.65) - cnl_frac\\n    phi_d265 = (2.65 - den) / (2.65 - 1.0)\\n    add(\"gas_d_n\", phi_d265 - cnl_frac)\\n    # 声波孔隙度（多套 dt_ma，dt_f=620 μs/m）\\n    for dt_ma in (143.0, 182.0, 204.0):\\n        phi_s = (ac - dt_ma) / (620.0 - dt_ma)\\n        add(f\"phiS_{int(dt_ma)}\", phi_s)\\n    # 电阻率对数\\n    with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\\n        add(\"logRT\", np.log10(np.clip(rt, 1e-3, 1e5)))\\n        add(\"logRXO\", np.log10(np.clip(rxo, 1e-3, 1e5)))\\n        add(\"logRXO_RT\", np.log10(np.clip(rxo / np.clip(rt, 1e-3, 1e5), 1e-4, 1e4)))\\n    # Archie 小网格（phi 取 phiD265 截断）\\n    phi_cli = np.clip(phi_d265, 0.01, 0.4)\\n    for rw, m, nn in ((0.05, 2.0, 2.0), (0.10, 2.0, 2.0), (0.05, 1.8, 2.0)):\\n        with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\\n            sw_a = (((1.0 * rw) / (np.power(phi_cli, m) * np.clip(rt, 1e-3, 1e5))) ** (1.0 / nn)) * 100.0\\n        add(f\"archie_{rw}_{m}_{nn}\", np.clip(sw_a, 0, 200))\\n    # GR 泥质指数（井内 5%/95% 端点）\\n    try:\\n        glo = np.nanquantile(gr, 0.05)\\n        ghi = np.nanquantile(gr, 0.95)\\n    except Exception:\\n        glo, ghi = np.nan, np.nan\\n    if not np.isfinite(glo) or not np.isfinite(ghi) or ghi <= glo:\\n        ish = np.full(n, np.nan)\\n    else:\\n        ish = (gr - glo) / (ghi - glo)\\n    add(\"gr_shale_lin\", np.clip(ish, -0.5, 1.5))\\n    # Larionov 老地层非线性\\n    with np.errstate(invalid=\"ignore\"):\\n        add(\"gr_shale_lar\", 0.33 * (2.0 ** (2.0 * np.clip(ish, -0.5, 1.5)) - 1.0))\\n    # GR-密度交会\\n    add(\"gr_den\", gr * den / 100.0)\\n    # SP 异常（相对 101 窗中值基线）\\n    sp_s = pd.Series(sp)\\n    sp_base = sp_s.rolling(window=101, min_periods=1, center=True).median().to_numpy()\\n    add(\"sp_anom\", sp - sp_base)\\n    # 井径/钻头比\\n    with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\\n        add(\"cal_bit_ratio\", cal / np.clip(bit, 1e-3, 1e4))\\n    add(\"cal_minus_bit\", cal - bit)\\n    # 井斜与方位角\\n    add(\"devi\", devi)\\n    az = np.deg2rad(np.clip(azim, -720, 720))\\n    add(\"azim_sin\", np.sin(az))\\n    add(\"azim_cos\", np.cos(az))\\n\\n    # ---- 5. 井内相对深度（删除绝对深度） ----\\n    depth = pd.to_numeric(well_df[\"DEPTH\"], errors=\"coerce\").to_numpy(dtype=float)\\n    dmin, dmax = np.nanmin(depth), np.nanmax(depth)\\n    span = dmax - dmin if np.isfinite(dmax - dmin) and (dmax - dmin) > 0 else 1.0\\n    add(\"rel_depth\", (depth - dmin) / span)\\n    add(\"dist_top\", depth - dmin)\\n    add(\"dist_bot\", dmax - depth)\\n\\n    # ---- 6. 全井聚合（广播） ----\\n    add(\"well_len\", np.full(n, float(n)))\\n    add(\"well_span\", np.full(n, float(span)))\\n    for c in ALL_INPUTS:\\n        v = pd.to_numeric(df[c], errors=\"coerce\").astype(float).to_numpy() if c in df.columns else np.full(n, np.nan)\\n        mr = float(np.mean(np.isnan(v))) if n else 0.0\\n        add(f\"wellmiss_{c}\", np.full(n, mr))\\n    for c, q in ((\"GR\", 0.5), (\"DEN\", 0.5), (\"AC\", 0.5), (\"RT\", 0.5), (\"CNL\", 0.5)):\\n        v = pd.to_numeric(df[c], errors=\"coerce\").astype(float).to_numpy() if c in df.columns else np.full(n, np.nan)\\n        try:\\n            med = float(np.nanmedian(v))\\n        except Exception:\\n            med = np.nan\\n        if not np.isfinite(med):\\n            med = 0.0\\n        add(f\"wellmed_{c}\", np.full(n, med))\\n\\n    feat_df = pd.DataFrame(feats)\\n    # 有限性：inf -> NaN（LightGBM 可处理 NaN）\\n    feat_df = feat_df.replace([np.inf, -np.inf], np.nan)\\n    return feat_df\\n\\n\\ndef robust_standardize_per_well(feat_df: pd.DataFrame, clip: float = 10.0) -> pd.DataFrame:\\n    \"\"\"按井鲁棒标准化（中位数/IQR），供 CNN 用。NaN 填 0，标准化值截断到 ±clip。\\n\\n    clip 必须存在：实测井 59 的 CNL 有 ~6e5 野值段（非 -99999 哨兵，未被转 NaN），\\n    二阶差分放大到 9e5，除以极小 IQR 后 |z| 达 2.6e6，fp16（上限 65504）直接\\n    溢出成 inf → NaN 毒化全网权重 → 该折 AUC 恒 0.5（Kaggle 首跑 fold0 崩塌真因）。\\n    \"\"\"\\n    out = feat_df.copy()\\n    for c in out.columns:\\n        v = out[c].to_numpy(dtype=float)\\n        med = np.nanmedian(v)\\n        q75, q25 = np.nanquantile(v, 0.75), np.nanquantile(v, 0.25)\\n        iqr = q75 - q25\\n        if not np.isfinite(med):\\n            med = 0.0\\n        if not np.isfinite(iqr) or iqr < 1e-9:\\n            iqr = 1.0\\n        z = (np.where(np.isnan(v), med, v) - med) / iqr\\n        out[c] = np.clip(np.where(np.isnan(z), 0.0, z), -clip, clip)\\n    return out.fillna(0.0)\\n\\n\\ndef feature_names() -> list[str]:\\n    \"\"\"返回特征列名（用一口虚拟井推导，保证顺序稳定）。\"\"\"\\n    import pandas as pd\\n    import numpy as np\\n\\n    dummy = pd.DataFrame(\\n        {c: np.zeros(10) for c in ([\"DEPTH\"] + ALL_INPUTS)}\\n    )\\n    dummy[\"DEPTH\"] = np.arange(10) * 0.1 + 1000.0\\n    return list(build_features(dummy).columns)\\n',\n","  'src/decide.py': # sha:2fb167a731af\n","    '\"\"\"决策层：OOF 校准 -> 逐目标闭式阈值 -> 离散 argmax -> 仅 PERM 平滑。\"\"\"\\nfrom __future__ import annotations\\n\\nimport numpy as np\\nfrom sklearn.isotonic import IsotonicRegression\\n\\nfrom . import config as C\\n\\n\\ndef closed_form_threshold(a_t: float) -> float:\\n    \"\"\"p > A/(1+A) 时输出占位。\"\"\"\\n    return float(a_t / (1.0 + a_t))\\n\\n\\ndef fit_calibrator(p_oof: np.ndarray, y_oof: np.ndarray):\\n    \"\"\"等温回归校准。返回有 predict 方法的对象；样本不足时返回恒等。\"\"\"\\n    p = np.asarray(p_oof, dtype=float)\\n    y = np.asarray(y_oof, dtype=int)\\n    m = np.isfinite(p) & np.isfinite(y)\\n    p, y = p[m], y[m]\\n    if len(p) < 100 or len(np.unique(y)) < 2:\\n        class _Id:\\n            def predict(self, x):\\n                return np.clip(np.asarray(x, dtype=float), 0, 1)\\n\\n        return _Id()\\n    ir = IsotonicRegression(out_of_bounds=\"clip\", y_min=0.0, y_max=1.0)\\n    ir.fit(p, y)\\n    return ir\\n\\n\\ndef apply_thresholds(\\n    p_ph: np.ndarray,\\n    por_reg: np.ndarray,\\n    perm_reg: np.ndarray,\\n    sw_reg: np.ndarray,\\n    taus: dict | None = None,\\n    sw_scale: float = C.SW_SCALE,\\n) -> tuple[np.ndarray, np.ndarray, np.ndarray]:\\n    \"\"\"离散候选 argmax（禁止数值混合）。逐目标独立门控。\\n\\n    输出占位 ⟺ p > tau_t。占位值：POR 0.1 / PERM 0.01 / SW 99.9*sw_scale。\\n    回归值直接采用；PERM 回归值钳到正数。\\n    \"\"\"\\n    if taus is None:\\n        taus = C.TAU_INIT\\n    p = np.asarray(p_ph, dtype=float)\\n    por_r = np.asarray(por_reg, dtype=float)\\n    perm_r = np.maximum(np.asarray(perm_reg, dtype=float), 1e-6)\\n    sw_r = np.asarray(sw_reg, dtype=float) * 1.0  # 回归器本身输出百分制\\n\\n    por = np.where(p > taus[\"POR\"], C.PH_POR, por_r)\\n    perm = np.where(p > taus[\"PERM\"], C.PH_PERM, perm_r)\\n    sw_ph = C.PH_SW * sw_scale\\n    sw = np.where(p > taus[\"SW\"], sw_ph, sw_r)\\n    return por, perm, sw\\n\\n\\ndef smooth_perm_log(perm: np.ndarray, window: int = 5) -> np.ndarray:\\n    \"\"\"仅 PERM 在 log10 空间平滑（POR/SW 禁止）。window 为奇数。\"\"\"\\n    assert window >= 1 and window % 2 == 1\\n    if window == 1:\\n        return np.asarray(perm, dtype=float)\\n    x = np.log10(np.maximum(np.asarray(perm, dtype=float), 1e-6))\\n    s = np.convolve(x, np.ones(window) / window, mode=\"same\")\\n    # 边界用较小的窗口重算，避免 same 卷积的零填充偏差\\n    h = window // 2\\n    n = len(x)\\n    out = s.copy()\\n    for i in range(min(h, n)):\\n        out[i] = np.mean(x[: i + h + 1])\\n        j = n - 1 - i\\n        out[j] = np.mean(x[j - h :])\\n    return np.power(10.0, out)\\n\\n\\ndef tune_thresholds_oof(\\n    p_oof: np.ndarray,\\n    reg_oof: dict,\\n    y_true: dict,\\n    mask: dict,\\n    radius: float = C.TAU_TUNE_RADIUS,\\n    grid: int = 11,\\n) -> dict:\\n    \"\"\"以闭式阈值为初值，在 ±radius 内逐目标网格搜索 OOF 总分。返回 {POR,PERM,SW: tau}。\"\"\"\\n    from .scoring import score_all\\n\\n    base = {t: closed_form_threshold(0.348 if t == \"POR\" else (0.766 if t == \"PERM\" else 0.171)) for t in (\"POR\", \"PERM\", \"SW\")}\\n    # 若调用方给了 A_t，优先用 C.TAU_INIT（与 base 一致）\\n    base = dict(C.TAU_INIT)\\n    best = dict(base)\\n    # 逐目标坐标下降两轮\\n    for _ in range(2):\\n        for t in (\"POR\", \"PERM\", \"SW\"):\\n            cands = np.linspace(max(0.01, best[t] - radius), min(0.99, best[t] + radius), grid)\\n            best_score = -1.0\\n            best_v = best[t]\\n            for v in cands:\\n                taus = dict(best)\\n                taus[t] = float(v)\\n                por, perm, sw = apply_thresholds(p_oof, reg_oof[\"POR\"], reg_oof[\"PERM\"], reg_oof[\"SW\"], taus)\\n                sc = score_all(y_true, {\"POR\": por, \"PERM\": perm, \"SW\": sw}, mask)\\n                if sc[\"total\"] > best_score:\\n                    best_score = sc[\"total\"]\\n                    best_v = float(v)\\n            best[t] = best_v\\n    return best\\n\\n\\ndef paired_bootstrap_ci(\\n    score_fn,\\n    n_boot: int = 2000,\\n    seed: int = C.SEED,\\n    ci: float = 0.90,\\n) -> tuple[float, float, float]:\\n    \"\"\"井级 paired bootstrap。score_fn() 返回 (a_wells, b_wells) 逐井分数数组。\\n\\n    返回 (mean_diff, lo, hi)。\\n    \"\"\"\\n    rng = np.random.default_rng(seed)\\n    a, b = score_fn()\\n    a = np.asarray(a, dtype=float)\\n    b = np.asarray(b, dtype=float)\\n    assert a.shape == b.shape and a.ndim == 1\\n    n = len(a)\\n    diffs = []\\n    for _ in range(n_boot):\\n        idx = rng.integers(0, n, n)\\n        diffs.append(float(np.mean(b[idx] - a[idx])))\\n    lo_q = (1 - ci) / 2 * 100\\n    hi_q = (1 + ci) / 2 * 100\\n    return float(np.mean(b - a)), float(np.percentile(diffs, lo_q)), float(np.percentile(diffs, hi_q))\\n',\n","  'src/blend.py': # sha:f1ec114c0e29\n","    '\"\"\"融合决策：校准 + 权重网格 + 阈值微调，严格按 PLAN §3.3 采纳门槛选优。\\n\\n背景（Kaggle 首跑实测）：CNN 5 折 ph-AUC 0.966~0.979，但 p 按 0.5 等权融合后\\nOOF 总分 79.62 < LGBM 单独 79.77。原因：闭式阈值极低（0.146/0.258/0.434），\\n真正起作用的是 p 在 0.15~0.43 附近的分辨力；CNN 未校准、过度自信，\\n等权平均破坏了 LGBM 的标定。故必须先校准再融合，且要按 OOF 实测选权重。\\n\"\"\"\\nfrom __future__ import annotations\\n\\nimport json\\nfrom pathlib import Path\\n\\nimport numpy as np\\nfrom sklearn.isotonic import IsotonicRegression\\nfrom sklearn.model_selection import GroupKFold\\n\\nfrom . import config as C\\nfrom . import decide as D\\nfrom . import scoring as S\\n\\n\\ndef _well_splits(groups: np.ndarray, n_splits: int = 5):\\n    \"\"\"按井分组切（groups=井号）。返回 [(train行mask, val行mask)]。\"\"\"\\n    g = np.asarray(groups)\\n    uniq = np.unique(g)\\n    idx = np.arange(len(uniq))\\n    out = []\\n    for tr_g, va_g in GroupKFold(n_splits=n_splits).split(idx, groups=idx):\\n        tr_w = set(uniq[tr_g])\\n        va_w = set(uniq[va_g])\\n        out.append((np.array([x in tr_w for x in g]), np.array([x in va_w for x in g])))\\n    return out\\n\\n\\ndef crossfit_calibrate(p: np.ndarray, groups: np.ndarray, y: np.ndarray, n_splits: int = 5) -> np.ndarray:\\n    \"\"\"交叉拟合等温校准（按井分折，避免同折拟合+评估的泄漏）。\"\"\"\\n    p = np.asarray(p, dtype=float)\\n    y = np.asarray(y, dtype=float)\\n    out = np.zeros_like(p)\\n    for tr_m, va_m in _well_splits(groups, n_splits):\\n        if tr_m.sum() < 100 or len(np.unique(y[tr_m])) < 2 or va_m.sum() == 0:\\n            out[va_m] = p[va_m]\\n            continue\\n        ir = IsotonicRegression(out_of_bounds=\"clip\", y_min=0.0, y_max=1.0)\\n        ir.fit(p[tr_m], y[tr_m])\\n        out[va_m] = ir.predict(p[va_m])\\n    return out\\n\\n\\ndef fit_calibrator(p: np.ndarray, y: np.ndarray):\\n    \"\"\"在全部 OOF 上拟合校准器，供推理期应用到测试集预测。\"\"\"\\n    p = np.asarray(p, dtype=float)\\n    y = np.asarray(y, dtype=float)\\n    if len(p) < 100 or len(np.unique(y)) < 2:\\n        return None\\n    ir = IsotonicRegression(out_of_bounds=\"clip\", y_min=0.0, y_max=1.0)\\n    ir.fit(p, y)\\n    return ir\\n\\n\\ndef _per_well_totals(y_true, y_pred, mask, groups) -> np.ndarray:\\n    out = []\\n    for g in np.unique(np.asarray(groups)):\\n        m = np.asarray(groups) == g\\n        mk = {t: (mask[t][m] if mask.get(t) is not None else None) for t in (\"POR\", \"PERM\", \"SW\")}\\n        yt = {t: y_true[t][m] for t in (\"POR\", \"PERM\", \"SW\")}\\n        yp = {t: y_pred[t][m] for t in (\"POR\", \"PERM\", \"SW\")}\\n        out.append(S.score_all(yt, yp, mk)[\"total\"])\\n    return np.asarray(out)\\n\\n\\ndef search_blend(\\n    p_lgbm: np.ndarray,\\n    p_cnn_raw: np.ndarray,\\n    groups: np.ndarray,\\n    y_true: dict,\\n    mask: dict,\\n    reg: dict,\\n    is_ph: np.ndarray,\\n    taus0: dict | None = None,\\n    weights=(0.0, 0.25, 0.5, 0.75, 1.0),\\n    use_calib=(False, True),\\n    tune_radius: float = C.TAU_TUNE_RADIUS,\\n    n_boot: int = 1000,\\n    seed: int = C.SEED,\\n    adopt_min_effect: float = 0.5,\\n):\\n    \"\"\"网格搜 (w, calib, taus)，返回表格 + 采纳结论（PLAN §3.3 三门槛）。\\n\\n    采纳门槛：井级 paired bootstrap 90% CI 下界 > 0、效应量 >= 0.5 分。\\n    不满足则返回 w=0（纯 LGBM，保底口径）。\\n    \"\"\"\\n    taus0 = dict(taus0 or C.TAU_INIT)\\n    groups = np.asarray(groups)\\n\\n    # 基线：w=0、不校准、原阈值\\n    por0, perm0, sw0 = D.apply_thresholds(p_lgbm, reg[\"POR\"], reg[\"PERM\"], reg[\"SW\"], taus0, C.SW_SCALE)\\n    base_pred = {\"POR\": por0, \"PERM\": perm0, \"SW\": sw0}\\n    base_total = S.score_all(y_true, base_pred, mask)[\"total\"]\\n    base_wells = _per_well_totals(y_true, base_pred, mask, groups)\\n\\n    # 交叉拟合校准（对 CNN 概率）\\n    p_cnn_cal = crossfit_calibrate(p_cnn_raw, groups, is_ph)\\n\\n    rows = []\\n    for w in weights:\\n        p_use = p_cnn_cal if True else p_cnn_raw\\n        for cal in use_calib:\\n            if cal and w == 0.0:\\n                continue\\n            p = (1 - w) * p_lgbm + w * (p_cnn_cal if cal else p_cnn_raw)\\n            # 阈值：原值 或 在 ±radius 内逐目标坐标下降微调\\n            cands = [taus0]\\n            if w > 0 and tune_radius > 0:\\n                tuned = D.tune_thresholds_oof(p, reg, y_true, mask, radius=tune_radius, grid=5)\\n                cands.append(tuned)\\n            for ti, taus in enumerate(cands):\\n                por, perm, sw = D.apply_thresholds(p, reg[\"POR\"], reg[\"PERM\"], reg[\"SW\"], taus, C.SW_SCALE)\\n                sc = S.score_all(y_true, {\"POR\": por, \"PERM\": perm, \"SW\": sw}, mask)\\n                wells = _per_well_totals(y_true, {\"POR\": por, \"PERM\": perm, \"SW\": sw}, mask, groups)\\n                diff = wells - base_wells\\n                lo = hi = float(\"nan\")\\n                if np.isfinite(diff).all():\\n                    rng = np.random.default_rng(seed)\\n                    idxs = rng.integers(0, len(diff), (n_boot, len(diff)))\\n                    boots = diff[idxs].mean(axis=1)\\n                    lo = float(np.percentile(boots, 5))\\n                    hi = float(np.percentile(boots, 95))\\n                rows.append({\\n                    \"w\": w, \"calib\": bool(cal), \"tuned\": bool(ti == 1 and len(cands) > 1),\\n                    \"taus\": dict(taus), \"total\": sc[\"total\"], \"POR\": sc[\"POR\"],\\n                    \"PERM\": sc[\"PERM\"], \"SW\": sc[\"SW\"],\\n                    \"effect\": float(diff.mean()), \"ci_lo\": lo, \"ci_hi\": hi,\\n                    \"wells\": wells,\\n                })\\n\\n    base_row = rows[0]\\n    # 只在通过三门槛的候选里选最优；否则基线\\n    ok = [r for r in rows if r[\"w\"] > 0 and np.isfinite(r[\"ci_lo\"]) and r[\"ci_lo\"] > 0\\n          and r[\"effect\"] >= adopt_min_effect]\\n    best = max(ok, key=lambda r: r[\"total\"]) if ok else base_row\\n    return {\\n        \"rows\": [{k: v for k, v in r.items() if k != \"wells\"} for r in rows],\\n        \"base_total\": base_total,\\n        \"best\": {k: v for k, v in best.items() if k != \"wells\"},\\n        \"adopted\": bool(ok),\\n        \"n_pass\": len(ok),\\n    }\\n\\n\\ndef save_decision(cnn_dir: Path | str, res: dict, calibrator=None) -> None:\\n    import joblib\\n\\n    cnn_dir = Path(cnn_dir)\\n    cnn_dir.mkdir(parents=True, exist_ok=True)\\n    payload = {\\n        \"weight\": res[\"best\"][\"w\"],\\n        \"calibrate\": res[\"best\"][\"calib\"],\\n        \"taus\": res[\"best\"][\"taus\"],\\n        \"adopted\": res[\"adopted\"],\\n        \"base_total\": res[\"base_total\"],\\n        \"best_total\": res[\"best\"][\"total\"],\\n        \"effect\": res[\"best\"][\"effect\"],\\n        \"ci\": [res[\"best\"][\"ci_lo\"], res[\"best\"][\"ci_hi\"]],\\n        \"n_pass\": res[\"n_pass\"],\\n    }\\n    with open(cnn_dir / \"blend.json\", \"w\") as fh:\\n        json.dump(payload, fh, indent=2)\\n    if calibrator is not None and payload[\"calibrate\"]:\\n        joblib.dump(calibrator, cnn_dir / \"calibrator.joblib\")\\n    elif payload[\"calibrate\"]:\\n        (cnn_dir / \"calibrator.joblib\").unlink(missing_ok=True)\\n\\n\\ndef load_decision(cnn_dir: Path | str) -> dict:\\n    p = Path(cnn_dir) / \"blend.json\"\\n    if not p.is_file():\\n        return {}\\n    try:\\n        with open(p) as fh:\\n            return json.load(fh)\\n    except Exception:\\n        return {}',\n","  'src/dataset.py': # sha:5688c11bbaf5\n","    '\"\"\"CNN 切片数据集：4096/重叠1024，余弦窗加权拼接。\\n\\n已知偏差（相对 PLAN §5.3）：PLAN 要求每个切片双端镜像填充 RF//2=1022，\\n本实现未做（`pad_for_rf` 保留备用）。理由：卷积已用 same-padding 保长度，\\n切片边界误差由 1024 重叠 + 余弦窗压制；全长扩展（4096→6140）会使\\nwidth192 网络在 T4-16G 上 OOM 风险显著上升。井首尾约 1022 点的边界质量\\n低于中部，属已知代价，见 REPORT §7。\\n\"\"\"\\nfrom __future__ import annotations\\n\\nimport numpy as np\\n\\nfrom . import config as C\\nfrom . import model_cnn as MC\\n\\n\\ndef slice_indices(n: int, length: int = C.SLICE_LEN, step: int = C.SLICE_STEP):\\n    \"\"\"切片索引。n<=length 返回单片；否则步进取片，尾片锚定末端。\\n\\n    注：尾片锚定导致小井（如 n=4473）重叠远大于名义 1024（例：[(0,4096),(377,4473)]\\n    重叠 3719）。正确但冗余约 2x 计算；全井>4096 且长度集中在 9k~13k，\\n    冗余可接受，故保持简单实现。\\n    \"\"\"\\n    if n <= length:\\n        return [(0, n)]\\n    out = []\\n    s = 0\\n    while s + length < n:\\n        out.append((s, s + length))\\n        s += step\\n    out.append((n - length, n))\\n    return out\\n\\n\\ndef pad_for_rf(x: np.ndarray, rf: int | None = None) -> np.ndarray:\\n    \"\"\"x: (F, L)；双端镜像填充 rf//2。\\n\\n    注意：当前训练/推理管线未调用本函数（见模块文档的已知偏差）。\\n    保留供后续启用全长 RF 扩展时使用。\\n    \"\"\"\\n    if rf is None:\\n        rf = MC.receptive_field()\\n    p = rf // 2\\n    if p <= 0:\\n        return x\\n    return np.pad(x, ((0, 0), (p, p)), mode=\"reflect\")\\n\\n\\ndef overlap_weights(length: int = C.SLICE_LEN) -> np.ndarray:\\n    \"\"\"距切片中心越近权重越大（余弦窗）。\\n\\n    注：PLAN 写“指数加权平均”，实现为余弦窗。两者都是中心高、边缘低的\\n    单调加权，效果等价，名实差一个词，见 REPORT。\\n    \"\"\"\\n    i = np.arange(length, dtype=float)\\n    w = 0.5 + 0.5 * np.cos(np.pi * (i - length / 2) / (length / 2))\\n    return np.clip(w, 1e-3, 1.0)\\n',\n","  'src/model_cnn.py': # sha:3cdc7c423288\n","    '\"\"\"多任务空洞 1D CNN（Kaggle GPU 用；本地无 torch 时仅做结构定义）。\\n\\nRF = 1 + (k-1)·Σd = 1 + 4·511 = 2045 点 = 204.5 m，覆盖最长占位 183.6 m。\\n6 个头：ph / por / perm_log / sw / swcap / permfloor。\\n\"\"\"\\nfrom __future__ import annotations\\n\\ntry:\\n    import torch\\n    import torch.nn as nn\\n\\n    HAS_TORCH = True\\nexcept Exception:  # 本地无 torch 时允许导入\\n    torch = None  # type: ignore\\n    nn = None  # type: ignore\\n    HAS_TORCH = False\\n\\nfrom . import config as C\\n\\n\\ndef receptive_field(kernel: int = C.CNN_KERNEL, dilations=None) -> int:\\n    if dilations is None:\\n        dilations = C.CNN_DILATIONS\\n    return 1 + (kernel - 1) * sum(dilations)\\n\\n\\nif HAS_TORCH:\\n\\n    class ResidualBlock(nn.Module):\\n        def __init__(self, width: int, kernel: int, dilation: int, dropout: float):\\n            super().__init__()\\n            pad = (kernel - 1) // 2 * dilation\\n            self.conv1 = nn.Conv1d(width, width, kernel, padding=pad, dilation=dilation)\\n            self.gn1 = nn.GroupNorm(8, width)\\n            self.act = nn.GELU()\\n            self.drop = nn.Dropout(dropout)\\n            self.conv2 = nn.Conv1d(width, width, kernel, padding=pad, dilation=dilation)\\n            self.gn2 = nn.GroupNorm(8, width)\\n\\n        def forward(self, x):\\n            h = self.conv1(x)\\n            h = self.gn1(h)\\n            h = self.act(h)\\n            h = self.drop(h)\\n            h = self.conv2(h)\\n            h = self.gn2(h)\\n            return self.act(x + h)\\n\\n    class GatedCNN(nn.Module):\\n        def __init__(\\n            self,\\n            n_feat: int,\\n            width: int = C.CNN_WIDTH,\\n            kernel: int = C.CNN_KERNEL,\\n            dilations=None,\\n            dropout: float = C.CNN_DROPOUT,\\n        ):\\n            super().__init__()\\n            if dilations is None:\\n                dilations = C.CNN_DILATIONS\\n            self.stem = nn.Conv1d(n_feat, width, 1)\\n            self.blocks = nn.ModuleList(\\n                [ResidualBlock(width, kernel, d, dropout) for d in dilations]\\n            )\\n            self.head_ph = nn.Conv1d(width, 1, 1)\\n            self.head_por = nn.Conv1d(width, 1, 1)\\n            self.head_perm = nn.Conv1d(width, 1, 1)  # log10(perm)\\n            self.head_sw = nn.Conv1d(width, 1, 1)\\n            self.head_swcap = nn.Conv1d(width, 1, 1)\\n            self.head_permfloor = nn.Conv1d(width, 1, 1)\\n\\n        def forward(self, x):\\n            # x: (B, F, L)\\n            h = self.stem(x)\\n            for b in self.blocks:\\n                h = b(h)\\n            return {\\n                \"ph\": self.head_ph(h).squeeze(1),\\n                \"por\": self.head_por(h).squeeze(1),\\n                \"perm_log\": self.head_perm(h).squeeze(1),\\n                \"sw\": self.head_sw(h).squeeze(1),\\n                \"swcap\": self.head_swcap(h).squeeze(1),\\n                \"permfloor\": self.head_permfloor(h).squeeze(1),\\n            }\\n\\nelse:\\n\\n    class GatedCNN:  # type: ignore\\n        def __init__(self, *a, **k):\\n            raise ImportError(\"需要 torch 才能实例化 GatedCNN\")\\n',\n","  'src/train_cnn.py': # sha:79fc1f55d8b1\n","    '\"\"\"CNN 训练：多任务空洞1D CNN，5折按井，切片4096/重叠1024，fp16，双T4 DataParallel。\\n\\n头与损失（对齐指标）：\\n- ph: BCE（batch 级正负均衡：wpos/wneg 按 batch 内有效样本的正负比例算，\\n  clip 到 [0.25,4]。batch 混多井（占位比 37%~80%），是逐井归一化的近似；\\n  效果可接受，精确逐井加权待后续）。权重 1.0（主目标）\\n- por: 截断相对 L1 = 1-Acc_POR，权重 0.3\\n- perm: log10 截断 L1 = 1-Acc_PERM，权重 0.3\\n- sw: 截断相对 L1 = 1-Acc_SW，权重 0.3\\n- swcap/permfloor: BCE，权重 0.3（会话2消融项，会话1照训不决策）\\n\\n设计说明（决策 2）：por/perm/sw（含 swcap/permfloor）是有意为之的辅助任务，\\n只参与梯度共享、不参与推理（推理回归头直接丢弃，只用 ph 门控 blended）。\\n若未来 OOF 证明某回归头超过 LGBM，再单独启用；此前按辅助任务处理。\\n\"\"\"\\nfrom __future__ import annotations\\n\\nimport json\\nfrom pathlib import Path\\n\\nimport numpy as np\\n\\nfrom . import config as C\\n\\ntry:\\n    import torch\\n    import torch.nn as nn\\n    from torch.utils.data import Dataset, DataLoader\\n\\n    HAS_TORCH = True\\nexcept Exception:\\n    torch = None  # type: ignore\\n    nn = None  # type: ignore\\n    Dataset = object  # type: ignore\\n    DataLoader = None  # type: ignore\\n    HAS_TORCH = False\\n\\n\\ndef _require_torch():\\n    if not HAS_TORCH:\\n        raise ImportError(\"需要 torch 才能训练/推理 CNN（Kaggle GPU 会话）\")\\n\\n\\n# ---------------- 数据 ----------------\\n\\ndef build_cnn_table(data_root, split=\"train\"):\\n    \"\"\"逐井：152特征 -> 按井鲁棒标准化 -> (F,L) float32；标签与mask（行级）。\"\"\"\\n    from . import features as F\\n    from . import io_data as IO\\n    from . import labels as LB\\n\\n    data_root = Path(data_root)\\n    files = IO.list_well_files(data_root, split)\\n    assert files, f\"无数据: {data_root}/{split}\"\\n    wells = []\\n    for f in files:\\n        df = IO.read_well(f)\\n        X = F.build_features(df)\\n        Xs = F.robust_standardize_per_well(X).to_numpy(dtype=np.float32)\\n        item = {\\n            \"logId\": IO.well_id_of(f),\\n            \"depths\": df[\"DEPTH\"].to_numpy(dtype=float),\\n            \"X\": Xs.transpose(1, 0).copy(),  # (F,L)\\n            \"feature_names\": list(X.columns),\\n            \"n\": len(df),\\n        }\\n        if split == \"train\":\\n            state, mask = LB.make_labels(df)\\n            st = state.to_numpy()\\n            por = df[\"POR\"].to_numpy(dtype=float)\\n            perm = df[\"PERM\"].to_numpy(dtype=float)\\n            sw = df[\"SW\"].to_numpy(dtype=float)\\n            is_ph = (st == \"PH\").astype(np.float32)\\n            valid_ph = (st != \"MISS\").astype(np.float32)\\n            mpor = mask[\"POR\"].to_numpy() & (st == \"VALID\")\\n            mperm = mask[\"PERM\"].to_numpy() & (st == \"VALID\")\\n            msw = mask[\"SW\"].to_numpy() & (st == \"VALID\")\\n            item.update({\\n                \"y_ph\": is_ph, \"m_ph\": valid_ph,\\n                \"y_por\": por.astype(np.float32), \"m_por\": mpor.astype(np.float32),\\n                \"y_permlog\": np.log10(np.maximum(perm, 1e-6)).astype(np.float32),\\n                \"m_perm\": mperm.astype(np.float32),\\n                \"y_sw\": sw.astype(np.float32), \"m_sw\": msw.astype(np.float32),\\n                # swcap：SW==99.9 为正。VALID 行偶发恰好 99.9 会被标正，属罕见\\n                # 噪声（训练集占比可忽略），与 PH 主正样本一致。\\n                \"y_swcap\": (sw == C.PH_SW).astype(np.float32),\\n                \"m_swcap\": (st != \"MISS\").astype(np.float32),\\n                # permfloor：PERM<=0.015 为正（含 PH 的 0.01；VALID 低渗尾部亦为正）。\\n                \"y_pfloor\": (perm <= 0.015).astype(np.float32),\\n                \"m_pfloor\": (st != \"MISS\").astype(np.float32),\\n            })\\n        wells.append(item)\\n    return wells\\n\\n\\ndef slice_list(n, length=C.SLICE_LEN, step=C.SLICE_STEP):\\n    from .dataset import slice_indices\\n\\n    return slice_indices(n, length, step)\\n\\n\\ndef _pad_slice_1d(arr: np.ndarray, s: int, e: int, length: int = C.SLICE_LEN):\\n    \"\"\"取 [s,e) 段，不足 length 时沿第 0 轴右沿反射补齐。\\n\\n    接受 1D（标签/掩码，(L,)）与 2D（转置后特征，(L,F)）输入，只垫第 0 轴。\\n    训练/测试井全 >4096，正常走不到补齐分支；n<=4096 的短井/单测会走到。\\n    \"\"\"\\n    seg = arr[s:e]\\n    if len(seg) >= length:\\n        return seg[:length]\\n    pad = length - len(seg)\\n    if seg.ndim == 1:\\n        return np.pad(seg, (0, pad), mode=\"reflect\")\\n    if seg.ndim == 2:\\n        return np.pad(seg, ((0, pad), (0, 0)), mode=\"reflect\")\\n    raise ValueError(f\"_pad_slice_1d 只支持 1D/2D，实得 {seg.ndim}D\")\\n\\n\\nif HAS_TORCH:\\n\\n    class SliceDataset(Dataset):\\n        def __init__(self, wells, well_idx, train: bool = True):\\n            self.samples = []\\n            for wi in well_idx:\\n                w = wells[wi]\\n                for (s, e) in slice_list(w[\"n\"]):\\n                    self.samples.append((wi, s, e))\\n            self.wells = wells\\n            self.train = train\\n\\n        def __len__(self):\\n            return len(self.samples)\\n\\n        def __getitem__(self, i):\\n            wi, s, e = self.samples[i]\\n            w = self.wells[wi]\\n            L = C.SLICE_LEN\\n            x = _pad_slice_1d(w[\"X\"].transpose(1, 0), s, e, L).transpose(1, 0).copy()\\n            out = {\"x\": torch.from_numpy(x)}\\n            if \"y_ph\" in w:\\n                out.update({\\n                    \"y_ph\": torch.from_numpy(_pad_slice_1d(w[\"y_ph\"], s, e, L).copy()),\\n                    \"m_ph\": torch.from_numpy(_pad_slice_1d(w[\"m_ph\"], s, e, L).copy()),\\n                    \"y_por\": torch.from_numpy(_pad_slice_1d(w[\"y_por\"], s, e, L).copy()),\\n                    \"m_por\": torch.from_numpy(_pad_slice_1d(w[\"m_por\"], s, e, L).copy()),\\n                    \"y_permlog\": torch.from_numpy(_pad_slice_1d(w[\"y_permlog\"], s, e, L).copy()),\\n                    \"m_perm\": torch.from_numpy(_pad_slice_1d(w[\"m_perm\"], s, e, L).copy()),\\n                    \"y_sw\": torch.from_numpy(_pad_slice_1d(w[\"y_sw\"], s, e, L).copy()),\\n                    \"m_sw\": torch.from_numpy(_pad_slice_1d(w[\"m_sw\"], s, e, L).copy()),\\n                    \"y_swcap\": torch.from_numpy(_pad_slice_1d(w[\"y_swcap\"], s, e, L).copy()),\\n                    \"m_swcap\": torch.from_numpy(_pad_slice_1d(w[\"m_swcap\"], s, e, L).copy()),\\n                    \"y_pfloor\": torch.from_numpy(_pad_slice_1d(w[\"y_pfloor\"], s, e, L).copy()),\\n                    \"m_pfloor\": torch.from_numpy(_pad_slice_1d(w[\"m_pfloor\"], s, e, L).copy()),\\n                })\\n            return out\\n\\n\\n# ---------------- 损失 ----------------\\n\\ndef _trunc_l1_por(pred, true, eps=C.EPS):\\n    return torch.clamp(torch.abs(pred - true) / (0.08 * (torch.abs(true) + eps)), max=1.0)\\n\\n\\ndef _trunc_l1_sw(pred, true, eps=C.EPS):\\n    return torch.clamp(torch.abs(pred - true) / (0.05 * (torch.abs(true) + eps)), max=1.0)\\n\\n\\ndef _trunc_l1_permlog(pred, true):\\n    return torch.clamp(torch.abs(pred - true), max=1.0)\\n\\n\\ndef multi_loss(out, b, w_ph=1.0, w_reg=0.3, w_aux=0.3):\\n    \"\"\"返回 (total, dict)。ph 逐切片正负均衡。\"\"\"\\n    # ph 均衡 BCE\\n    m = b[\"m_ph\"]\\n    y = b[\"y_ph\"]\\n    logit = out[\"ph\"]\\n    n_pos = (y * m).sum()\\n    n_neg = ((1 - y) * m).sum()\\n    n_tot = (n_pos + n_neg).clamp_min(1.0)\\n    wpos = (n_tot / (2 * n_pos.clamp_min(1.0))).clamp(0.25, 4.0)\\n    wneg = (n_tot / (2 * n_neg.clamp_min(1.0))).clamp(0.25, 4.0)\\n    bce = nn.functional.binary_cross_entropy_with_logits(logit, y, reduction=\"none\")\\n    wmap = torch.where(y > 0.5, wpos, wneg) * m\\n    loss_ph = (bce * wmap).sum() / m.sum().clamp_min(1.0)\\n\\n    def _masked(fn, pred, true, mask):\\n        v = fn(pred, true) * mask\\n        return v.sum() / mask.sum().clamp_min(1.0)\\n\\n    loss_por = _masked(_trunc_l1_por, out[\"por\"], b[\"y_por\"], b[\"m_por\"])\\n    loss_perm = _masked(_trunc_l1_permlog, out[\"perm_log\"], b[\"y_permlog\"], b[\"m_perm\"])\\n    loss_sw = _masked(_trunc_l1_sw, out[\"sw\"], b[\"y_sw\"], b[\"m_sw\"])\\n    loss_swcap = (nn.functional.binary_cross_entropy_with_logits(out[\"swcap\"], b[\"y_swcap\"], reduction=\"none\") * b[\"m_swcap\"]).sum() / b[\"m_swcap\"].sum().clamp_min(1.0)\\n    loss_pf = (nn.functional.binary_cross_entropy_with_logits(out[\"permfloor\"], b[\"y_pfloor\"], reduction=\"none\") * b[\"m_pfloor\"]).sum() / b[\"m_pfloor\"].sum().clamp_min(1.0)\\n    total = w_ph * loss_ph + w_reg * (loss_por + loss_perm + loss_sw) + w_aux * (loss_swcap + loss_pf)\\n    return total, {\"ph\": loss_ph, \"por\": loss_por, \"perm\": loss_perm, \"sw\": loss_sw,\\n                   \"swcap\": loss_swcap, \"pfloor\": loss_pf}\\n\\n\\n# ---------------- 训练 ----------------\\n\\ndef _autocast_ctx():\\n    \"\"\"torch.amp（2.x）优先，旧版回退 torch.cuda.amp。T4 无 bf16，用 fp16。\"\"\"\\n    try:\\n        return torch.amp.autocast(\"cuda\")\\n    except Exception:\\n        return torch.cuda.amp.autocast()\\n\\n\\ndef _make_scaler():\\n    try:\\n        return torch.amp.GradScaler(\"cuda\")\\n    except Exception:\\n        return torch.cuda.amp.GradScaler()\\n\\n\\ndef _seed_all(seed: int) -> None:\\n    import random\\n\\n    random.seed(seed)\\n    np.random.seed(seed)\\n    torch.manual_seed(seed)\\n    try:\\n        torch.cuda.manual_seed_all(seed)\\n    except Exception:\\n        pass\\n    try:\\n        torch.backends.cudnn.deterministic = True\\n        torch.backends.cudnn.benchmark = False\\n    except Exception:\\n        pass\\n    # 注：DataParallel 多卡归约仍有残余非确定性；跨会话要求逐值复现时固定用单卡推理。\\n\\n\\ndef _worker_init(worker_id: int) -> None:\\n    import random\\n\\n    ws = (torch.initial_seed() + worker_id) % 2**32\\n    np.random.seed(ws)\\n    random.seed(ws)\\n\\n\\ndef _well_folds(n_wells, n_splits=5, seed=C.SEED):\\n    from sklearn.model_selection import GroupKFold\\n\\n    idx = np.arange(n_wells)\\n    gkf = GroupKFold(n_splits=n_splits)\\n    return list(gkf.split(idx, groups=idx))\\n\\n\\ndef _torch_load_state(path):\\n    \"\"\"只载 state_dict（纯 tensors）。新版 torch 先 weights_only=True，\\n    失败（UnpicklingError 等）则回退 weights_only=False。\\n    检查点均为本次训练自产，来源可信。\"\"\"\\n    try:\\n        obj = torch.load(str(path), map_location=\"cpu\", weights_only=True)\\n    except Exception:\\n        try:\\n            import torch.serialization as _ts\\n\\n            try:\\n                _ts.add_safe_globals([\"numpy._core.multiarray.scalar\"])\\n            except Exception:\\n                pass\\n            obj = torch.load(str(path), map_location=\"cpu\", weights_only=True)\\n        except Exception:\\n            obj = torch.load(str(path), map_location=\"cpu\", weights_only=False)\\n    if isinstance(obj, dict) and \"state\" in obj and not any(\\n        str(k).startswith(\"head_\") or str(k).startswith(\"stem.\") or str(k).startswith(\"blocks.\")\\n        for k in obj.keys()\\n    ):\\n        # 兼容旧格式 {state, auc, n_feat, feature_names}\\n        return obj[\"state\"], {k: v for k, v in obj.items() if k != \"state\"}\\n    return obj, {}\\n\\n\\ndef _torch_load(path):\\n    \"\"\"兼容旧检查点：返回 {state, ...} 或 state_dict。\"\"\"\\n    try:\\n        obj = torch.load(str(path), map_location=\"cpu\", weights_only=True)\\n    except Exception:\\n        try:\\n            import torch.serialization as _ts\\n\\n            try:\\n                _ts.add_safe_globals([\"numpy._core.multiarray.scalar\"])\\n            except Exception:\\n                pass\\n            obj = torch.load(str(path), map_location=\"cpu\", weights_only=True)\\n        except Exception:\\n            obj = torch.load(str(path), map_location=\"cpu\", weights_only=False)\\n    return obj\\n\\n\\ndef _save_ckpt(fdir, state_dict, meta: dict) -> None:\\n    \"\"\"新格式：best.pt 只存 state_dict（纯 tensors，weights_only 可载）；\\n    元信息（auc/n_feat/feature_names）存 meta.json。\"\"\"\\n    torch.save({k: v.cpu() for k, v in state_dict.items()}, fdir / \"best.pt\")\\n    with open(fdir / \"meta.json\", \"w\") as fh:\\n        json.dump({\"auc\": float(meta.get(\"auc\", -1)), \"n_feat\": int(meta.get(\"n_feat\", 0)),\\n                   \"feature_names\": list(meta.get(\"feature_names\", []))}, fh)\\n\\n\\ndef _load_ckpt(fdir):\\n    \"\"\"返回 (state_dict, meta)。兼容旧格式 best.pt（含 meta）。\"\"\"\\n    fdir = Path(fdir)\\n    state, meta = _torch_load_state(fdir / \"best.pt\")\\n    mp = fdir / \"meta.json\"\\n    if mp.exists():\\n        try:\\n            meta = json.load(open(mp))\\n        except Exception:\\n            pass\\n    return state, meta\\n\\n\\ndef _make_model(n_feat, device, n_gpu):\\n    from .model_cnn import GatedCNN\\n\\n    _require_torch()\\n    m = GatedCNN(n_feat=n_feat)\\n    m.to(device)\\n    if n_gpu >= 2:\\n        m = nn.DataParallel(m)\\n    return m\\n\\n\\ndef _unwrap(m):\\n    return m.module if isinstance(m, nn.DataParallel) else m\\n\\n\\nREUSE_AUC_MIN = 0.60  # 断点续训：已有权重 AUC 高于此则复用，崩塌（~0.5）/缺失则重训\\n\\n\\ndef _try_reuse_fold(fdir: Path, n_feat: int):\\n    \"\"\"尝试复用该折已有权重。返回 (state, meta) 或 (None, {})。\"\"\"\\n    fdir = Path(fdir)\\n    bp = fdir / \"best.pt\"\\n    if not bp.is_file():\\n        return None, {}\\n    try:\\n        state, meta = _load_ckpt(fdir)\\n        auc = float(meta.get(\"auc\", 0.0)) if isinstance(meta, dict) else 0.0\\n        if auc >= REUSE_AUC_MIN and state is not None:\\n            return state, meta\\n        print(f\"[cnn] {fdir.name} 已有权重但 auc={auc:.4f}（崩塌/过低），重训\", flush=True)\\n    except Exception as e:\\n        print(f\"[cnn] {fdir.name} 权重读取失败，重训: {e}\", flush=True)\\n    return None, {}\\n\\n\\ndef train_cnn_cv(wells, out_dir, n_splits=5, seed=C.SEED, max_epochs=20,\\n                 patience=6, min_epochs=6, batch=16, lr=3e-4, device=None):\\n    \"\"\"5折训练，存 fold{k}/best.pt + oof_*.npy（行序对齐 wells 拼接）。返回 oof dict。\"\"\"\\n    _require_torch()\\n    out_dir = Path(out_dir)\\n    out_dir.mkdir(parents=True, exist_ok=True)\\n    if device is None:\\n        device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\\n    n_gpu = torch.cuda.device_count() if \"cuda\" in device else 0\\n    # 双T4：batch 翻倍（每卡 batch//2），DataParallel 分流。\\n    # 注：LR 不按 batch 缩放（保持 3e-4，保证与单卡 OOF 可比；width192/L4096 在\\n    # T4-16G 上偏紧，batch32 若 OOM 会自动减半重试并重头训该折）。\\n    if n_gpu >= 2:\\n        batch = batch * 2\\n    print(f\"[cnn] device={device} n_gpu={n_gpu} batch={batch} epochs={max_epochs}\")\\n\\n    _seed_all(seed)\\n    n_feat = wells[0][\"X\"].shape[0]\\n    folds = _well_folds(len(wells), n_splits, seed)\\n    with open(out_dir / \"folds.json\", \"w\") as fh:\\n        json.dump({\"seed\": seed, \"wells\": [w[\"logId\"] for w in wells],\\n                   \"folds\": [{\"train\": tr.tolist(), \"val\": va.tolist()} for tr, va in folds]}, fh)\\n\\n    from sklearn.metrics import roc_auc_score\\n\\n    oof_p = np.full(sum(w[\"n\"] for w in wells), np.nan, dtype=float)\\n    oof_por = np.full_like(oof_p, np.nan)\\n    oof_perm = np.full_like(oof_p, np.nan)\\n    oof_sw = np.full_like(oof_p, np.nan)\\n    offsets = np.cumsum([0] + [w[\"n\"] for w in wells])\\n\\n    use_amp = (\"cuda\" in device)\\n    for fold, (tr, va) in enumerate(folds):\\n        fdir = out_dir / f\"fold{fold}\"\\n        fdir.mkdir(parents=True, exist_ok=True)\\n        # 断点续训：已有好权重（auc>=0.60）直接复用，只算该折 OOF，不重训\\n        _reuse_state, _reuse_meta = _try_reuse_fold(fdir, n_feat)\\n        if _reuse_state is not None:\\n            print(f\"[cnn] fold{fold} 复用已有权重 \"\\n                  f\"auc={float(_reuse_meta.get(\\'auc\\', 0)):.4f}，跳过训练\", flush=True)\\n            model = _make_model(n_feat, \"cpu\", 0)\\n            _unwrap(model).load_state_dict(_reuse_state)\\n            model.eval()\\n            for wi in va:\\n                p, por, perm, sw = predict_cnn_well_array(wells[wi], model, \"cpu\")\\n                s, e = offsets[wi], offsets[wi + 1]\\n                oof_p[s:e], oof_por[s:e], oof_perm[s:e], oof_sw[s:e] = p, por, perm, sw\\n            del model\\n            continue\\n        cur_batch = batch\\n        use_amp_fold = use_amp\\n        fold_seed = seed + fold\\n        while True:\\n            try:\\n                escalate = False\\n                best_auc, best_state, bad = -1.0, None, 0\\n                model = _make_model(n_feat, device, n_gpu)\\n                opt = torch.optim.AdamW(model.parameters(), lr=lr, weight_decay=1e-2)\\n                sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=max_epochs)\\n                scaler = _make_scaler() if use_amp_fold else None\\n                _gen = torch.Generator().manual_seed(fold_seed)\\n                dtr = DataLoader(SliceDataset(wells, tr, True), batch_size=cur_batch,\\n                                 shuffle=True, num_workers=2, pin_memory=(\"cuda\" in device),\\n                                 generator=_gen, worker_init_fn=_worker_init)\\n                dva = DataLoader(SliceDataset(wells, va, False), batch_size=cur_batch,\\n                                 shuffle=False, num_workers=2, pin_memory=(\"cuda\" in device),\\n                                 worker_init_fn=_worker_init)\\n                for ep in range(max_epochs):\\n                    model.train()\\n                    for b in dtr:\\n                        x = b[\"x\"].to(device, non_blocking=True)\\n                        bt = {k: (v.to(device, non_blocking=True) if isinstance(v, torch.Tensor) else v)\\n                              for k, v in b.items() if k != \"x\"}\\n                        opt.zero_grad()\\n                        if use_amp_fold:\\n                            with _autocast_ctx():\\n                                out = model(x)\\n                                loss, _ = multi_loss(out, bt)\\n                            scaler.scale(loss).backward()\\n                            scaler.step(opt)\\n                            scaler.update()\\n                        else:\\n                            out = model(x)\\n                            loss, _ = multi_loss(out, bt)\\n                            loss.backward()\\n                            opt.step()\\n                    sched.step()\\n                    # 验证：ph AUC\\n                    model.eval()\\n                    ps, ys = [], []\\n                    with torch.no_grad():\\n                        for b in dva:\\n                            x = b[\"x\"].to(device, non_blocking=True)\\n                            if use_amp_fold:\\n                                with _autocast_ctx():\\n                                    out = model(x)\\n                            else:\\n                                out = model(x)\\n                            prob = torch.sigmoid(out[\"ph\"]).float().cpu().numpy().ravel()\\n                            y = b[\"y_ph\"].numpy().ravel()\\n                            m = b[\"m_ph\"].numpy().ravel() > 0.5\\n                            ps.append(prob[m])\\n                            ys.append(y[m])\\n                    ps = np.concatenate(ps)\\n                    ys = np.concatenate(ys)\\n                    try:\\n                        auc = roc_auc_score(ys, ps) if len(np.unique(ys)) > 1 else 0.5\\n                    except Exception:\\n                        auc = 0.5\\n                    if auc > best_auc:\\n                        best_auc = auc\\n                        best_state = {k: v.cpu() for k, v in _unwrap(model).state_dict().items()}\\n                        bad = 0\\n                    else:\\n                        bad += 1\\n                    print(f\"[cnn] fold{fold} ep{ep} auc={auc:.4f} best={best_auc:.4f}\", flush=True)\\n                    if use_amp_fold and ep >= 2 and best_auc < 0.60:\\n                        print(f\"[cnn] fold{fold} fp16 下 AUC 仍 <0.60，升级 fp32 重训本折\", flush=True)\\n                        escalate = True\\n                        break\\n                    if ep >= min_epochs and bad >= patience:\\n                        break\\n                if escalate:\\n                    use_amp_fold = False\\n                    fold_seed += 1\\n                    _seed_all(fold_seed)\\n                    continue  # 重开本折（fp32）\\n                _save_ckpt(fdir, best_state,\\n                           {\"auc\": best_auc, \"n_feat\": n_feat,\\n                            \"feature_names\": wells[0][\"feature_names\"]})\\n                print(f\"[cnn] fold{fold} done best_auc={best_auc:.4f} amp={use_amp_fold}\", flush=True)\\n                break\\n            except RuntimeError as e:\\n                if \"out of memory\" in str(e).lower() and cur_batch > 4:\\n                    cur_batch //= 2\\n                    print(f\"[cnn] OOM -> batch {cur_batch}\", flush=True)\\n                    try:\\n                        torch.cuda.empty_cache()\\n                    except Exception:\\n                        pass\\n                    continue\\n                raise\\n        # OOF：加载最优（新格式 best.pt + meta.json，兼容旧格式）\\n        state, _meta = _load_ckpt(fdir)\\n        model = _make_model(n_feat, \"cpu\", 0)\\n        _unwrap(model).load_state_dict(state)\\n        model.eval()\\n        for wi in va:\\n            p, por, perm, sw = predict_cnn_well_array(wells[wi], model, \"cpu\")\\n            s, e = offsets[wi], offsets[wi + 1]\\n            oof_p[s:e], oof_por[s:e], oof_perm[s:e], oof_sw[s:e] = p, por, perm, sw\\n    np.save(out_dir / \"oof_p.npy\", oof_p)\\n    np.save(out_dir / \"oof_por.npy\", oof_por)\\n    np.save(out_dir / \"oof_perm.npy\", oof_perm)\\n    np.save(out_dir / \"oof_sw.npy\", oof_sw)\\n    return {\"oof_p\": oof_p, \"oof_por\": oof_por, \"oof_perm\": oof_perm, \"oof_sw\": oof_sw}\\n\\n\\n@torch.no_grad() if HAS_TORCH else (lambda f: f)\\ndef predict_cnn_well_array(well, model, device=\"cpu\"):\\n    \"\"\"单井：切片 -> 余弦加权拼接。返回 (p, por, perm, sw) 原始长度。\"\"\"\\n    from .dataset import slice_indices, overlap_weights\\n\\n    _require_torch()\\n    X = well[\"X\"]  # (F,L)\\n    n = well[\"n\"]\\n    L = C.SLICE_LEN\\n    w_win = overlap_weights(L)\\n    acc = {k: np.zeros(n, dtype=float) for k in (\"p\", \"por\", \"perm\", \"sw\", \"w\")}\\n    model.eval()\\n    for (s, e) in slice_indices(n, L, C.SLICE_STEP):\\n        seg = X[:, s:e]\\n        if seg.shape[1] < L:\\n            seg = np.pad(seg, ((0, 0), (0, L - seg.shape[1])), mode=\"reflect\")\\n        xt = torch.from_numpy(seg[None].astype(np.float32)).to(device)\\n        out = _unwrap(model)(xt)\\n        ln = e - s\\n        if ln < L:\\n            # 短井单切片（n<L）：取余弦窗中央段。单切片时权重经归一化抵消，\\n            # 取值不影响结果；中央段最对称。\\n            off = (L - ln) // 2\\n            w = w_win[off:off + ln]\\n        else:\\n            w = w_win\\n        acc[\"p\"][s:e] += torch.sigmoid(out[\"ph\"][0]).cpu().numpy()[:ln] * w\\n        acc[\"por\"][s:e] += out[\"por\"][0].cpu().numpy()[:ln] * w\\n        # perm_log 钳到 [-6,5]（PERM 合法 1e-6~5000，留余量）：未训好的头会输出\\n        # 极大值，直接 10^x 会 overflow 成 inf（fold0 崩塌时已复现告警）。\\n        _pl = np.clip(out[\"perm_log\"][0].cpu().numpy()[:ln], -6.0, 5.0)\\n        acc[\"perm\"][s:e] += np.power(10.0, _pl) * w\\n        acc[\"sw\"][s:e] += out[\"sw\"][0].cpu().numpy()[:ln] * w\\n        acc[\"w\"][s:e] += w\\n    wsum = np.maximum(acc[\"w\"], 1e-9)\\n    return acc[\"p\"] / wsum, acc[\"por\"] / wsum, acc[\"perm\"] / wsum, acc[\"sw\"] / wsum\\n\\n\\ndef train_cnn(*args, **kwargs):\\n    return train_cnn_cv(*args, **kwargs)\\n',\n","  'src/train_lgbm.py': # sha:835f52c42a18\n","    '\"\"\"LightGBM：占位分类器 + 3 回归器，GroupKFold(5) 按井，OOF 落盘。\"\"\"\\nfrom __future__ import annotations\\n\\nimport json\\nfrom pathlib import Path\\n\\nimport joblib\\nimport lightgbm as lgb\\nimport numpy as np\\nimport pandas as pd\\nfrom sklearn.model_selection import GroupKFold\\n\\nfrom . import config as C\\nfrom . import features as F\\nfrom . import io_data as IO\\nfrom . import labels as LB\\n\\n\\ndef prepare_table(data_root: Path | str, split: str = \"train\", cache: Path | str | None = None):\\n    \"\"\"读取全部井 -> (well_ids, depths_list, X, y_dict, state, mask)。X 为特征矩阵。\"\"\"\\n    data_root = Path(data_root)\\n    files = IO.list_well_files(data_root, split)\\n    assert files, f\"无数据文件: {data_root}/{split}\"\\n    well_ids, depths_list, feat_list = [], [], []\\n    y_por, y_perm, y_sw, states, mpor, mperm, msw, groups = [], [], [], [], [], [], [], []\\n    for i, f in enumerate(files):\\n        wid = IO.well_id_of(f)\\n        df = IO.read_well(f)\\n        well_ids.append(wid)\\n        depths_list.append(df[\"DEPTH\"].to_numpy(dtype=float))\\n        X = F.build_features(df)\\n        feat_list.append(X)\\n        if split == \"train\":\\n            state, mask = LB.make_labels(df)\\n            states.append(state.to_numpy())\\n            mpor.append(mask[\"POR\"].to_numpy())\\n            mperm.append(mask[\"PERM\"].to_numpy())\\n            msw.append(mask[\"SW\"].to_numpy())\\n            y_por.append(df[\"POR\"].to_numpy(dtype=float))\\n            y_perm.append(df[\"PERM\"].to_numpy(dtype=float))\\n            y_sw.append(df[\"SW\"].to_numpy(dtype=float))\\n            groups.extend([i] * len(df))\\n    X_all = pd.concat(feat_list, ignore_index=True) if feat_list else pd.DataFrame()\\n    # float32 省内存（LightGBM 原生支持 NaN）\\n    for c in X_all.columns:\\n        X_all[c] = X_all[c].astype(np.float32)\\n    out = {\\n        \"well_ids\": well_ids,\\n        \"depths_list\": depths_list,\\n        \"X\": X_all,\\n        \"feature_names\": list(X_all.columns),\\n    }\\n    if split == \"train\":\\n        out.update(\\n            {\\n                \"y_por\": np.concatenate(y_por),\\n                \"y_perm\": np.concatenate(y_perm),\\n                \"y_sw\": np.concatenate(y_sw),\\n                \"state\": np.concatenate(states),\\n                \"mask_por\": np.concatenate(mpor),\\n                \"mask_perm\": np.concatenate(mperm),\\n                \"mask_sw\": np.concatenate(msw),\\n                \"groups\": np.asarray(groups),\\n            }\\n        )\\n    if cache is not None:\\n        Path(cache).parent.mkdir(parents=True, exist_ok=True)\\n        joblib.dump(out, cache)\\n    return out\\n\\n\\ndef make_folds(groups: np.ndarray, n_splits: int = 5, seed: int = C.SEED):\\n    gkf = GroupKFold(n_splits=n_splits)\\n    # GroupKFold 无 shuffle；为可复现，按井 id 排序后固定划分\\n    idx = np.arange(len(groups))\\n    folds = list(gkf.split(idx, groups=groups))\\n    return folds\\n\\n\\ndef train_lgbm_cv(\\n    table: dict,\\n    out_dir: Path | str,\\n    n_splits: int = 5,\\n    seed: int = C.SEED,\\n    num_boost_round: int = C.LGBM_ROUNDS,\\n):\\n    \"\"\"5 折训练。返回 oof dict + models。\\n\\n    - 分类器：目标为 is_ph（PH=1），MISS 行排除\\n    - 回归器：仅在 mask_t & 非 PH 行上训练（占位行由门控负责）\\n      POR/SW 用 L1，PERM 用 log10+L1\\n    \"\"\"\\n    out_dir = Path(out_dir)\\n    out_dir.mkdir(parents=True, exist_ok=True)\\n    X = table[\"X\"]\\n    feature_names = table[\"feature_names\"]\\n    y_por = table[\"y_por\"]\\n    y_perm = table[\"y_perm\"]\\n    y_sw = table[\"y_sw\"]\\n    state = table[\"state\"]\\n    mpor = table[\"mask_por\"]\\n    mperm = table[\"mask_perm\"]\\n    msw = table[\"mask_sw\"]\\n    groups = table[\"groups\"]\\n\\n    is_ph = (state == \"PH\").astype(int)\\n    is_miss = state == \"MISS\"\\n    # 分类训练 mask：排除 MISS（输入零信号，不可学）\\n    cls_mask = ~is_miss\\n    # 回归训练 mask：VALID 且逐目标有效（排除 PH 与 GARBAGE 该目标）\\n    reg_por_mask = mpor & (state == \"VALID\")\\n    reg_perm_mask = mperm & (state == \"VALID\")\\n    reg_sw_mask = msw & (state == \"VALID\")\\n\\n    folds = make_folds(groups, n_splits)\\n    with open(out_dir / \"folds.json\", \"w\") as fh:\\n        json.dump(\\n            {\\n                \"seed\": seed,\\n                \"n_splits\": n_splits,\\n                \"folds\": [\\n                    {\"train_idx\": tr.tolist(), \"val_idx\": va.tolist()}\\n                    for tr, va in folds\\n                ],\\n                \"well_ids\": table[\"well_ids\"],\\n            },\\n            fh,\\n        )\\n\\n    n = len(X)\\n    oof_p = np.full(n, np.nan)\\n    oof_por = np.full(n, np.nan)\\n    oof_perm = np.full(n, np.nan)\\n    oof_sw = np.full(n, np.nan)\\n    models = []\\n\\n    for fold, (tr, va) in enumerate(folds):\\n        fdir = out_dir / f\"fold{fold}\"\\n        fdir.mkdir(parents=True, exist_ok=True)\\n        dtr_cls = lgb.Dataset(X.iloc[tr][cls_mask[tr]], label=is_ph[tr][cls_mask[tr]])\\n        dva_cls = lgb.Dataset(X.iloc[va][cls_mask[va]], label=is_ph[va][cls_mask[va]], reference=dtr_cls)\\n        clf = lgb.train(\\n            dict(C.LGBM_CLASSIFIER_PARAMS, seed=seed + fold),\\n            dtr_cls,\\n            num_boost_round=num_boost_round,\\n            valid_sets=[dva_cls],\\n            callbacks=[lgb.early_stopping(C.LGBM_EARLY_STOP, verbose=False)],\\n        )\\n        clf.save_model(str(fdir / \"clf.txt\"))\\n        oof_p[va[cls_mask[va]]] = clf.predict(X.iloc[va][cls_mask[va]])\\n        # MISS 行的 p 填井内均值（推理时无特殊处理，此处仅为 OOF 完整）\\n        miss_va = va[is_miss[va]]\\n        if len(miss_va):\\n            oof_p[miss_va] = 0.0\\n\\n        # 回归器\\n        for name, tm, yv, trans in (\\n            (\"por\", reg_por_mask, y_por, None),\\n            (\"perm\", reg_perm_mask, y_perm, \"log10\"),\\n            (\"sw\", reg_sw_mask, y_sw, None),\\n        ):\\n            trm = tr[tm[tr]]\\n            vam = va[tm[va]]\\n            if len(trm) < 500 or len(vam) < 10:\\n                continue\\n            yt_tr = yv[trm]\\n            if trans == \"log10\":\\n                yt_tr = np.log10(np.maximum(yt_tr, 1e-6))\\n            dtr = lgb.Dataset(X.iloc[trm], label=yt_tr)\\n            yt_va = yv[vam]\\n            if trans == \"log10\":\\n                yt_va = np.log10(np.maximum(yt_va, 1e-6))\\n            dva = lgb.Dataset(X.iloc[vam], label=yt_va, reference=dtr)\\n            reg = lgb.train(\\n                dict(C.LGBM_REG_PARAMS, seed=seed + fold + 100),\\n                dtr,\\n                num_boost_round=num_boost_round,\\n                valid_sets=[dva],\\n                callbacks=[lgb.early_stopping(C.LGBM_EARLY_STOP, verbose=False)],\\n            )\\n            reg.save_model(str(fdir / f\"reg_{name}.txt\"))\\n            pred = reg.predict(X.iloc[vam])\\n            if trans == \"log10\":\\n                pred = np.power(10.0, pred)\\n            if name == \"por\":\\n                oof_por[vam] = pred\\n            elif name == \"perm\":\\n                oof_perm[vam] = pred\\n            else:\\n                oof_sw[vam] = pred\\n        models.append(str(fdir))\\n\\n    # 未被回归 OOF 覆盖的行（PH/MISS/GARBAGE）填中位数兜底，供评分函数 mask 后忽略\\n    for arr, yv in ((oof_por, y_por), (oof_perm, y_perm), (oof_sw, y_sw)):\\n        med = float(np.nanmedian(yv[(mpor if arr is oof_por else (mperm if arr is oof_perm else msw)) & (state == \"VALID\")]))\\n        arr[np.isnan(arr)] = med\\n    oof_p[np.isnan(oof_p)] = 0.0\\n\\n    np.save(out_dir / \"oof_p.npy\", oof_p)\\n    np.save(out_dir / \"oof_por.npy\", oof_por)\\n    np.save(out_dir / \"oof_perm.npy\", oof_perm)\\n    np.save(out_dir / \"oof_sw.npy\", oof_sw)\\n    return {\\n        \"oof_p\": oof_p,\\n        \"oof_por\": oof_por,\\n        \"oof_perm\": oof_perm,\\n        \"oof_sw\": oof_sw,\\n        \"models\": models,\\n        \"feature_names\": feature_names,\\n    }\\n\\n\\ndef train_lgbm_full(table: dict, out_dir: Path | str, seed: int = C.SEED, num_boost_round: int = C.LGBM_ROUNDS):\\n    \"\"\"全量训练（用于最终提交），无验证集，固定轮数（取 CV 平均最佳轮数）。\"\"\"\\n    out_dir = Path(out_dir)\\n    out_dir.mkdir(parents=True, exist_ok=True)\\n    X = table[\"X\"]\\n    # 读 CV 的最佳轮数\\n    best_iters: list[int] = []\\n    for f in sorted(out_dir.glob(\"fold*/clf.txt\")):\\n        try:\\n            with open(f) as fh:\\n                for line in fh:\\n                    if line.startswith(\"num_iterations\"):\\n                        best_iters.append(int(line.split(\"=\")[1]))\\n                        break\\n        except Exception:\\n            pass\\n    rounds = int(np.median(best_iters)) if best_iters else 300\\n    rounds = max(100, min(rounds, num_boost_round))\\n\\n    state = table[\"state\"]\\n    is_ph = (state == \"PH\").astype(int)\\n    is_miss = state == \"MISS\"\\n    cls_mask = ~is_miss\\n    reg_por_mask = table[\"mask_por\"] & (state == \"VALID\")\\n    reg_perm_mask = table[\"mask_perm\"] & (state == \"VALID\")\\n    reg_sw_mask = table[\"mask_sw\"] & (state == \"VALID\")\\n\\n    fdir = out_dir / \"full\"\\n    fdir.mkdir(parents=True, exist_ok=True)\\n    clf = lgb.train(\\n        dict(C.LGBM_CLASSIFIER_PARAMS, seed=seed),\\n        lgb.Dataset(X[cls_mask], label=is_ph[cls_mask]),\\n        num_boost_round=rounds,\\n    )\\n    clf.save_model(str(fdir / \"clf.txt\"))\\n    for name, m, yv, trans in (\\n        (\"por\", reg_por_mask, table[\"y_por\"], None),\\n        (\"perm\", reg_perm_mask, table[\"y_perm\"], \"log10\"),\\n        (\"sw\", reg_sw_mask, table[\"y_sw\"], None),\\n    ):\\n        yt = yv[m]\\n        if trans == \"log10\":\\n            yt = np.log10(np.maximum(yt, 1e-6))\\n        reg = lgb.train(\\n            dict(C.LGBM_REG_PARAMS, seed=seed),\\n            lgb.Dataset(X[m], label=yt),\\n            num_boost_round=rounds,\\n        )\\n        reg.save_model(str(fdir / f\"reg_{name}.txt\"))\\n    # 存特征名与轮数\\n    with open(fdir / \"meta.json\", \"w\") as fh:\\n        json.dump({\"rounds\": rounds, \"feature_names\": table[\"feature_names\"], \"seed\": seed}, fh)\\n    return str(fdir)\\n',\n","  'src/predict.py': # sha:b957791f80c0\n","    '\"\"\"推理：加载 LightGBM（CV 集成或全量），逐井预测 + 决策层 + 写 result.json。\"\"\"\\nfrom __future__ import annotations\\n\\nfrom pathlib import Path\\n\\nimport joblib\\nimport lightgbm as lgb\\nimport numpy as np\\nimport pandas as pd\\n\\nfrom . import config as C\\nfrom . import decide as D\\nfrom . import features as F\\nfrom . import io_data as IO\\n\\n\\ndef _load_booster(p: Path):\\n    return lgb.Booster(model_file=str(p))\\n\\n\\ndef _collect_models(model_dir: Path):\\n    model_dir = Path(model_dir)\\n    # 优先 full/，否则 fold*/ 集成\\n    full = model_dir / \"full\"\\n    if (full / \"clf.txt\").exists():\\n        return [full]\\n    folds = sorted([d for d in model_dir.glob(\"fold*\") if (d / \"clf.txt\").exists()])\\n    assert folds, f\"无可用模型: {model_dir}\"\\n    return folds\\n\\n\\ndef predict_well(df: pd.DataFrame, model_dirs: list[Path], feature_names: list[str] | None = None):\\n    X = F.build_features(df)\\n    if feature_names is not None:\\n        # 列顺序对齐，缺失补 NaN\\n        for c in feature_names:\\n            if c not in X.columns:\\n                X[c] = np.nan\\n        X = X[feature_names]\\n    p_list, por_list, perm_list, sw_list = [], [], [], []\\n    for md in model_dirs:\\n        clf = _load_booster(Path(md) / \"clf.txt\")\\n        p_list.append(clf.predict(X))\\n        for name, lst in ((\"por\", por_list), (\"perm\", perm_list), (\"sw\", sw_list)):\\n            fp = Path(md) / f\"reg_{name}.txt\"\\n            if fp.exists():\\n                reg = _load_booster(fp)\\n                pr = reg.predict(X)\\n                if name == \"perm\":\\n                    pr = np.power(10.0, pr)\\n                lst.append(pr)\\n    p = np.mean(np.stack(p_list), axis=0)\\n    por = np.mean(np.stack(por_list), axis=0) if por_list else np.full(len(X), 11.5)\\n    perm = np.mean(np.stack(perm_list), axis=0) if perm_list else np.full(len(X), 10.0)\\n    sw = np.mean(np.stack(sw_list), axis=0) if sw_list else np.full(len(X), 82.0)\\n    return p, por, perm, sw\\n\\n\\ndef predict_cnn_well(df: pd.DataFrame, ckpt_dirs: list[Path], feature_names: list[str] | None = None):\\n    \"\"\"CNN 集成（多折平均）。无 torch 或无检查点时返回 None。\"\"\"\\n    try:\\n        import torch\\n    except Exception:\\n        return None\\n    ckpts = []\\n    for d in ckpt_dirs:\\n        if (Path(d) / \"best.pt\").is_file():\\n            ckpts.append(Path(d))\\n    if not ckpts:\\n        return None\\n    from . import features as _F\\n    from .train_cnn import _load_ckpt, _make_model, predict_cnn_well_array, _unwrap\\n\\n    X = _F.build_features(df)\\n    if feature_names is not None:\\n        for c in feature_names:\\n            if c not in X.columns:\\n                X[c] = np.nan\\n        X = X[feature_names]\\n    Xs = _F.robust_standardize_per_well(X).to_numpy(dtype=np.float32).transpose(1, 0).copy()\\n    well = {\"X\": Xs, \"n\": len(df)}\\n    device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\\n    ps, pors, perms, sws = [], [], [], []\\n    for ck in ckpts:\\n        state, meta = _load_ckpt(ck)\\n        n_feat = int(meta.get(\"n_feat\", 0) or Xs.shape[0])\\n        m = _make_model(n_feat, \"cpu\", 0)\\n        _unwrap(m).load_state_dict(state)\\n        m.to(device)\\n        m.eval()\\n        p, por, perm, sw = predict_cnn_well_array(well, m, device)\\n        # NaN 兜底（崩塌折不应出现；出现也不允许污染 result.json）\\n        p = np.nan_to_num(p, nan=0.5, posinf=1.0, neginf=0.0)\\n        por = np.nan_to_num(por, nan=11.5, posinf=60.0, neginf=0.0)\\n        perm = np.nan_to_num(perm, nan=10.0, posinf=5000.0, neginf=1e-6)\\n        sw = np.nan_to_num(sw, nan=82.0, posinf=100.0, neginf=0.0)\\n        ps.append(p)\\n        pors.append(por)\\n        perms.append(perm)\\n        sws.append(sw)\\n        del m\\n        if \"cuda\" in device:\\n            torch.cuda.empty_cache()\\n    return (np.mean(np.stack(ps), 0), np.mean(np.stack(pors), 0),\\n            np.mean(np.stack(perms), 0), np.mean(np.stack(sws), 0))\\n\\n\\ndef _collect_cnn(cnn_dir: Path | str | None):\\n    if not cnn_dir:\\n        return []\\n    cnn_dir = Path(cnn_dir)\\n    folds = sorted([d for d in cnn_dir.glob(\"fold*\") if (d / \"best.pt\").exists()])\\n    return folds\\n\\n\\ndef predict_split(\\n    data_root: Path | str,\\n    model_dir: Path | str,\\n    split: str = \"test\",\\n    taus: dict | None = None,\\n    sw_scale: float = C.SW_SCALE,\\n    perm_smooth: int = 5,\\n    feature_names: list[str] | None = None,\\n    cnn_dir: Path | str | None = None,\\n    cnn_weight: float = 0.5,\\n    calibrate: bool = False,\\n) -> list[dict]:\\n    data_root = Path(data_root)\\n    model_dir = Path(model_dir)\\n    mdirs = _collect_models(model_dir)\\n    cdirs = _collect_cnn(cnn_dir)\\n    if cdirs:\\n        print(f\"[predict] CNN 集成: {len(cdirs)} 折, weight={cnn_weight}\")\\n    if feature_names is None:\\n        import json as _json\\n\\n        for cand in (model_dir / \"full\" / \"meta.json\",):\\n            if cand.exists():\\n                with open(cand) as fh:\\n                    feature_names = _json.load(fh)[\"feature_names\"]\\n                break\\n    files = IO.list_well_files(data_root, split)\\n    assert files, f\"无数据: {data_root}/{split}\"\\n    wells = []\\n    for f in files:\\n        df = IO.read_well(f)\\n        depths = df[\"DEPTH\"].to_numpy(dtype=float)\\n        p, por_r, perm_r, sw_r = predict_well(df, mdirs, feature_names)\\n        if cdirs and cnn_weight > 0:\\n            cnn_out = predict_cnn_well(df, cdirs, feature_names)\\n            if cnn_out is not None:\\n                p_cnn, _, _, _ = cnn_out\\n                # 训练期若判定\"校准\"有效，则对测试集 CNN 概率套用同一等温映射\\n                if calibrate:\\n                    try:\\n                        import joblib\\n\\n                        cal = joblib.load(Path(cnn_dir) / \"calibrator.joblib\")\\n                        p_cnn = np.clip(cal.predict(p_cnn), 0.0, 1.0)\\n                        print(\"[predict] 已套用 CNN 等温校准\")\\n                    except Exception as e:\\n                        print(f\"[predict] 校准器加载失败，用原始概率: {e}\")\\n                # 决策2：CNN 主攻门控，回归仍用 LGBM。CNN 的 por/perm/sw 是训练期\\n                # 辅助任务（梯度共享），推理期有意丢弃，不参与 argmax。\\n                p = (1 - cnn_weight) * p + cnn_weight * p_cnn\\n        por, perm, sw = D.apply_thresholds(p, por_r, perm_r, sw_r, taus, sw_scale)\\n        if perm_smooth and perm_smooth > 1:\\n            perm = D.smooth_perm_log(perm, window=perm_smooth)\\n        wells.append(\\n            {\"logId\": IO.well_id_of(f), \"depths\": depths, \"por\": por, \"perm\": perm, \"sw\": sw, \"p_ph\": p}\\n        )\\n    # 按 logId 排序，保证输出稳定\\n    wells.sort(key=lambda w: w[\"logId\"])\\n    return wells\\n',\n","  'src/main.py': # sha:6cbf310595a5\n","    '\"\"\"CLI：train / infer / both。\"\"\"\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport json\\nfrom pathlib import Path\\n\\nfrom . import config as C\\nfrom . import decide as D\\nfrom . import io_data as IO\\nfrom . import scoring as S\\n\\n\\ndef _clean_stale(out_dir: Path, patterns: list[str]) -> None:\\n    \"\"\"删除上次残留产物，避免新旧混用。\"\"\"\\n    import shutil\\n\\n    out_dir = Path(out_dir)\\n    for pat in patterns:\\n        for p in sorted(out_dir.glob(pat)):\\n            try:\\n                if p.is_dir() and not p.is_symlink():\\n                    shutil.rmtree(p)\\n                else:\\n                    p.unlink()\\n                print(f\"[clean] removed {p}\")\\n            except Exception as e:\\n                print(f\"[clean] 跳过 {p}: {e}\")\\n\\n\\ndef _lgbm_complete(out_dir: Path) -> bool:\\n    \"\"\"LGBM 产物齐套（可复用，不重训）：full 模型 + 阈值 + 4 个 OOF。\"\"\"\\n    out_dir = Path(out_dir)\\n    need = [out_dir / \"full\" / \"clf.txt\", out_dir / \"taus.json\",\\n            out_dir / \"oof_p.npy\", out_dir / \"oof_por.npy\",\\n            out_dir / \"oof_perm.npy\", out_dir / \"oof_sw.npy\"]\\n    return all(p.is_file() for p in need)\\n\\n\\ndef _load_lgbm_oof(out_dir: Path) -> dict:\\n    import numpy as _np\\n\\n    out_dir = Path(out_dir)\\n    return {\"oof_p\": _np.load(out_dir / \"oof_p.npy\"),\\n            \"oof_por\": _np.load(out_dir / \"oof_por.npy\"),\\n            \"oof_perm\": _np.load(out_dir / \"oof_perm.npy\"),\\n            \"oof_sw\": _np.load(out_dir / \"oof_sw.npy\")}\\n\\n\\ndef cmd_train(args) -> Path:\\n    from . import train_lgbm as TL\\n\\n    import numpy as np\\n\\n    data_root = IO.detect_data_root(args.data_dir)\\n    out_dir = Path(args.model_dir)\\n    print(f\"[train] data_root={data_root} model_dir={out_dir}\")\\n    table = TL.prepare_table(data_root, split=\"train\")\\n    print(f\"[train] rows={len(table[\\'X\\'])} feats={len(table[\\'feature_names\\'])} wells={len(table[\\'well_ids\\'])}\")\\n    if _lgbm_complete(out_dir) and not args.retrain:\\n        print(\"[train] LGBM 产物齐套，复用不再重训（如需重训加 --retrain）\")\\n        oof = _load_lgbm_oof(out_dir)\\n    else:\\n        # 只清 OOF/阈值（fold*/full 由训练覆盖写，无需删）\\n        _clean_stale(out_dir, [\"oof_*.npy\", \"taus.json\"])\\n        oof = TL.train_lgbm_cv(table, out_dir, n_splits=args.folds, seed=C.SEED)\\n    # OOF 评分（全量行 + 逐目标 mask）\\n    y_true = {\"POR\": table[\"y_por\"], \"PERM\": table[\"y_perm\"], \"SW\": table[\"y_sw\"]}\\n    mask = {\"POR\": table[\"mask_por\"], \"PERM\": table[\"mask_perm\"], \"SW\": table[\"mask_sw\"]}\\n    # 门控准确率\\n    is_ph = (table[\"state\"] == \"PH\")\\n    not_miss = table[\"state\"] != \"MISS\"\\n    pred_ph = oof[\"oof_p\"] > 0.5\\n    gate_acc = float(((pred_ph == is_ph)[not_miss]).mean())\\n    print(f\"[train] gate_acc(0.5)={gate_acc:.4f}\")\\n    # 闭式阈值决策（复用模式沿用已有 taus.json，不覆盖）\\n    taus = dict(C.TAU_INIT)\\n    _taus_path = out_dir / \"taus.json\"\\n    if _taus_path.is_file() and not args.retrain and not args.tune_tau:\\n        try:\\n            with open(_taus_path) as fh:\\n                taus = json.load(fh)\\n            print(f\"[train] 复用 taus={taus}\")\\n        except Exception:\\n            pass\\n    if args.tune_tau:\\n        reg_oof = {\"POR\": oof[\"oof_por\"], \"PERM\": oof[\"oof_perm\"], \"SW\": oof[\"oof_sw\"]}\\n        taus = D.tune_thresholds_oof(oof[\"oof_p\"], reg_oof, y_true, mask)\\n        print(f\"[train] tuned taus={taus}\")\\n    with open(out_dir / \"taus.json\", \"w\") as fh:\\n        json.dump(taus, fh, indent=2)\\n    por, perm, sw = D.apply_thresholds(oof[\"oof_p\"], oof[\"oof_por\"], oof[\"oof_perm\"], oof[\"oof_sw\"], taus, args.sw_scale)\\n    if args.perm_smooth and args.perm_smooth > 1:\\n        # OOF 是打散拼接，直接整体平滑会跨井污染；此处仅报告未平滑分，跨井平滑在 predict 端逐井做\\n        pass\\n    sc = S.score_all(y_true, {\"POR\": por, \"PERM\": perm, \"SW\": sw}, mask)\\n    print(f\"[train] OOF Acc POR={sc[\\'POR\\']:.4f} PERM={sc[\\'PERM\\']:.4f} SW={sc[\\'SW\\']:.4f} total={sc[\\'total\\']:.2f}\")\\n    # 有效行 Acc（门控条件，与占位比无关）\\n    valid = table[\"state\"] == \"VALID\"\\n    sc_valid = S.score_all(\\n        {t: y_true[t][valid & mask[t]] for t in (\"POR\", \"PERM\", \"SW\")},\\n        {t: {\"POR\": por, \"PERM\": perm, \"SW\": sw}[t][valid & mask[t]] for t in (\"POR\", \"PERM\", \"SW\")},\\n    )\\n    print(f\"[train] VALID-only Acc POR={sc_valid[\\'POR\\']:.4f} PERM={sc_valid[\\'PERM\\']:.4f} SW={sc_valid[\\'SW\\']:.4f}\")\\n    # 全量训练（最终提交用；复用模式下 full 已存在则跳过）\\n    if args.full and not ((out_dir / \"full\" / \"clf.txt\").is_file() and not args.retrain):\\n        from . import train_lgbm as TL2\\n\\n        TL2.train_lgbm_full(table, out_dir)\\n        print(\"[train] full models done\")\\n    elif args.full:\\n        print(\"[train] full 模型已存在，复用不再重训\")\\n    # CNN（GPU 会话）：以 ph 为主目标，回归为辅助；缺 torch 则跳过。\\n    # CNN 侧做断点续训（train_cnn_cv 内按折复用好权重），此处不删 fold*。\\n    if args.cnn:\\n        try:\\n            from . import train_cnn as TC\\n\\n            cnn_dir = Path(args.cnn_dir)\\n            print(f\"[train-cnn] cnn_dir={cnn_dir} epochs={args.cnn_epochs} batch={args.cnn_batch}\")\\n            wells = TC.build_cnn_table(data_root, split=\"train\")\\n            oof_cnn = TC.train_cnn_cv(\\n                wells, cnn_dir, n_splits=args.folds, seed=C.SEED,\\n                max_epochs=args.cnn_epochs, batch=args.cnn_batch,\\n                device=None if args.device == \"auto\" else args.device,\\n            )\\n            # ---- 融合决策：网格搜 (权重 × 校准 × 阈值微调)，按 PLAN §3.3 门槛采纳 ----\\n            from . import blend as B\\n\\n            reg_oof = {\"POR\": oof[\"oof_por\"], \"PERM\": oof[\"oof_perm\"], \"SW